{
  "name": "astro-web",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "upload_source_maps": true,
  "compatibility_date": "2026-11-03",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  },
  "cache": {
    "enabled": true
  }
}
