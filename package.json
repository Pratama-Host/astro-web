{
  "name": "astro-web",
  "version": "1.0.0",
  "private": true,
  "description": "Website kelas TKJ XII-9 SMK Muhammadiyah Belitang dengan CMS admin (Astro SSR, Cloudflare Workers, Supabase).",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "migrate:data": "node scripts/migrate-data.mjs",
    "media:upload": "node --env-file=.env scripts/upload-media.mjs",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "npm run check && npm test && npm run build",
    "deploy": "wrangler deploy"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pratama-Host/astro-web.git"
  },
  "keywords": [
    "astro",
    "cloudflare-workers",
    "supabase",
    "cms",
    "pwa",
    "school"
  ],
  "author": "Pratama-Host",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Pratama-Host/astro-web/issues"
  },
  "homepage": "https://github.com/Pratama-Host/astro-web#readme",
  "dependencies": {
    "@astrojs/cloudflare": "14.4.4",
    "@supabase/supabase-js": "2.118.0",
    "astro": "7.4.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "wrangler": "4.156.1",
    "@types/node": "24.19.2"
  },
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.23.4"
  }
}
