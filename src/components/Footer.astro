---
import Icon from './Icon.astro';
import { getSettings } from '../lib/data';
import { validPublicUrl } from '../lib/cms-admin';
const G = await getSettings();

const { year } = Astro.props;
const footerYear = year || String(G.tahunAjaran || '2026/2027').split('/')[0].trim() || '2026';

const platforms = [
  {
    key: 'instagram',
    icon: 'fa-brands fa-instagram',
    label: 'Instagram',
  },
  {
    key: 'youtube',
    icon: 'fa-brands fa-youtube',
    label: 'YouTube',
  },
  {
    key: 'tiktok',
    icon: 'fa-brands fa-tiktok',
    label: 'TikTok',
  },
];

const socialLinks = platforms.flatMap((platform) => {
  const href = validPublicUrl(G.sosmed?.[platform.key]);
  return href ? [{ ...platform, href }] : [];
});

const footerLinks = Array.isArray(G.footer?.links) ? G.footer.links.filter((item) => item?.enabled !== false && typeof item.href === 'string' && item.href.startsWith('/') && !item.href.startsWith('//')) : [
  { href: '/tkj', label: 'Info TKJ' }, { href: '/pengembang', label: 'Tentang' }, 
];
---

<footer class="kaki-strip wadah" role="contentinfo">
  <div class="footer-top">
    <div class="footer-copy">
      © <span class="footer-year hl">{footerYear}</span> {G.namaKelas || "XII-9"} · {G.namaSekolah || "SMK Muhammadiyah Belitang"}
    </div>
    <div class="footer-links">
      {footerLinks.map((item) => <a href={item.href}>{item.label}</a>)}
    </div>
  </div>
  <div class="sosial-kaki" aria-label="Sosial media kami">
    {socialLinks.map((platform) => (
      <a href={platform.href} target="_blank" rel="noopener noreferrer" aria-label={`${platform.label} TKJ XII-9`}>
        <Icon name={platform.icon} />
        <span>{platform.label}</span>
      </a>
    ))}
  </div>
  <div style="display: flex; justify-content: flex-end">
    <button id="replay-intro-tombol" type="button" aria-label="Putar ulang intro">
      <Icon name="fa-rotate-right" /> Replay Intro
    </button>
  </div>
</footer>
