---
import { getNavigation } from '../lib/data';
import Icon from './Icon.astro';
const items = await getNavigation();
---

<button id="hamburger-tombol" class="hamburger-tombol" aria-label="Buka menu" aria-expanded="false">
  <span class="hamburger-icon"><Icon name="fa-bars" size={20} /></span>
</button>

<nav id="menu-hamburger" aria-hidden="true" inert>
  <div class="panel-menu-hamburger">
    <button type="button" class="tutup-menu-hamburger" aria-label="Tutup menu">
      <Icon name="fa-times" size={20} />
    </button>
    {items.filter((item) => item.enabled !== false).map((item) => (
      <a class="tautan-menu-hamburger" href={item.href}>
        <span><Icon name={item.icon || 'fa-link'} size={20} /></span>
        <span>{item.label}</span>
      </a>
    ))}
  </div>
</nav>
