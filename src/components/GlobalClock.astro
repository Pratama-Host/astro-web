---
---
<div id="global-clock" role="timer" aria-label="Jam saat ini" title="Seret untuk memindahkan | Klik dua kali untuk mengembalikan posisi"></div>

<script>
  const el = document.getElementById('global-clock');
  if (el) {
    function fmt(d) {
      return d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
    }
    function update() {
      el.textContent = fmt(new Date());
    }
    update();
    setInterval(update, 1000);

    let savedPos = null;
    try { savedPos = localStorage.getItem('tkj-clock-pos'); } catch {}
    if (savedPos) {
      try {
        const pos = JSON.parse(savedPos);
        const cx = Math.max(8, Math.min(Number(pos.x) || 8, window.innerWidth - 80));
        const cy = Math.max(8, Math.min(Number(pos.y) || 8, window.innerHeight - 40));
        el.style.setProperty('left', cx + 'px', 'important');
        el.style.setProperty('top', cy + 'px', 'important');
        el.style.setProperty('bottom', 'auto', 'important');
      } catch {}
    }

    let isDragging = false, offsetX = 0, offsetY = 0;
    el.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'mouse' && e.button !== 0) return;
      e.preventDefault();
      isDragging = true;
      const rect = el.getBoundingClientRect();
      offsetX = e.clientX - rect.left;
      offsetY = e.clientY - rect.top;
      // Mobile CSS anchors the clock from the bottom. Clear that anchor before
      // applying a top coordinate, otherwise the fixed element can stretch.
      el.style.setProperty('left', rect.left + 'px', 'important');
      el.style.setProperty('top', rect.top + 'px', 'important');
      el.style.setProperty('bottom', 'auto', 'important');
      el.setPointerCapture(e.pointerId);
      el.classList.add('dragging');
      el.style.cursor = 'grabbing';
    });

    document.addEventListener('pointermove', (e) => {
      if (!isDragging) return;
      const maxLeft = Math.max(8, window.innerWidth - el.offsetWidth - 8);
      const maxTop = Math.max(8, window.innerHeight - el.offsetHeight - 8);
      el.style.setProperty('left', Math.max(8, Math.min(e.clientX - offsetX, maxLeft)) + 'px', 'important');
      el.style.setProperty('top', Math.max(8, Math.min(e.clientY - offsetY, maxTop)) + 'px', 'important');
    });

    document.addEventListener('pointerup', (e) => {
      if (!isDragging) return;
      isDragging = false;
      el.classList.remove('dragging');
      el.style.cursor = 'move';
      try { el.releasePointerCapture(e.pointerId); } catch {}
      const l = getComputedStyle(el).left, t = getComputedStyle(el).top;
      try { localStorage.setItem('tkj-clock-pos', JSON.stringify({ x: parseInt(l), y: parseInt(t) })); } catch {}
    });

    el.addEventListener('dblclick', () => {
      el.style.removeProperty('left');
      el.style.removeProperty('top');
      el.style.removeProperty('bottom');
      try { localStorage.removeItem('tkj-clock-pos'); } catch {}
    });
  }
</script>
