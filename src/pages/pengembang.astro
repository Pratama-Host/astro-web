  .dp-orbit-core { display: grid; place-items: center; width: 104px; height: 104px; border: 1px solid var(--dp-border-strong); border-radius: 30px; background: linear-gradient(145deg, var(--dp-panel-hover), var(--dp-panel)); color: var(--dp-cyan); font-size: 2.2rem; box-shadow: 0 0 65px rgba(110, 100, 255, 0.2), inset 0 0 25px rgba(255, 255, 255, 0.04); transform: rotate(-9deg); backdrop-filter: blur(10px); }
  .dp-orbit-node { position: absolute; width: 10px; height: 10px; border-radius: 50%; box-shadow: 0 0 18px currentColor; }
