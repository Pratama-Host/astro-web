---
import DeveloperLayout from '../layouts/DeveloperLayout.astro';
import { DEVELOPER_DEFAULTS } from '../data/developer-defaults';
import { getAnggota, getGaleri, getPageContent, getPageSEO, getSections, getSettings } from '../lib/data';

const [G, members, gallery, pageSEO, pageContent, sectionConfig] = await Promise.all([
  getSettings(),
  getAnggota(),
  getGaleri(),
  getPageSEO('/pengembang', Astro.request),
  getPageContent('/pengembang', Astro.request),
  getSections('/pengembang'),
]);

const asRecord = (value: unknown): Record<string, any> =>
  value && typeof value === 'object' && !Array.isArray(value) ? value as Record<string, any> : {};
const devContent = asRecord(pageContent.developer);
const devProfile = asRecord(devContent.profile);
const textValue = (value: unknown, fallback: string, max = 1200): string =>
  typeof value === 'string' && value.trim() ? value.trim().slice(0, max) : fallback;
const safeImage = (value: unknown): string | null => {
  if (typeof value !== 'string' || value.length > 2048) return null;
  if (value.startsWith('/') && !value.startsWith('//')) return value;
  try {
    const url = new URL(value);
    return url.protocol === 'https:' && !url.username && !url.password ? url.href : null;
  } catch {
    return null;
  }
};
const safeHref = (value: unknown): string | null => {
  if (typeof value !== 'string' || value.length > 2048) return null;
  if (value.startsWith('/') && !value.startsWith('//')) return value;
  try {
    const url = new URL(value);
    return ['https:', 'mailto:', 'tel:'].includes(url.protocol) && !url.username && !url.password ? url.href : null;
  } catch {
    return null;
  }
};
const safeExternalUrl = (value: unknown): string | null => {
  if (typeof value !== 'string' || value.length > 2048) return null;
  try {
    const url = new URL(value);
    return url.protocol === 'https:' && !url.username && !url.password ? url.href : null;
  } catch {
    return null;
  }
};
const normalizeObjects = (
  value: unknown,
  fallback: readonly any[],
  fields: string[],
  limit = 40,
): any[] => {
  if (!Array.isArray(value)) return fallback.map((item) => ({ ...item }));
  return value.slice(0, limit).flatMap((entry) => {
    const item = asRecord(entry);
    if (!fields.some((field) => typeof item[field] === 'string' && item[field].trim())) return [];
    const clean: Record<string, any> = {};
    for (const field of fields) {
      if (typeof item[field] === 'string') clean[field] = item[field].trim().slice(0, 6000);
    }
    if (typeof item.percent === 'number' || (typeof item.percent === 'string' && item.percent.trim())) {
      const percent = Number(item.percent);
      if (Number.isFinite(percent)) clean.percent = Math.min(100, Math.max(0, Math.round(percent)));
    }
    if (Array.isArray(item.paragraphs)) clean.paragraphs = item.paragraphs.filter((part: unknown) => typeof part === 'string').slice(0, 8).map((part: string) => part.slice(0, 5000));
    if (Array.isArray(item.tags)) clean.tags = item.tags.filter((tag: unknown) => typeof tag === 'string').slice(0, 10).map((tag: string) => tag.slice(0, 80));
    if (typeof item.href === 'string') clean.href = item.href.slice(0, 2048);
    if (typeof item.copy === 'string') clean.copy = item.copy.slice(0, 500);
    return [clean];
  });
};

const alfredoMember = members.find((member: any) => typeof member?.nama === 'string' && member.nama.toLowerCase().includes('alfredo')) || null;
const alfredoOrganization = Array.isArray(G.strukturOrg)
  ? G.strukturOrg.find((member: any) => typeof member?.nama === 'string' && member.nama.toLowerCase().includes('alfredo')) || null
  : null;
const alfredo = alfredoOrganization || alfredoMember;
const profileName = textValue(devProfile.name, alfredo?.nama || 'Alfredo Pratama', 100);
const profileRole = textValue(devProfile.role, alfredo?.jabatan || pageContent.role || 'Web Developer', 160);
const profileLocation = textValue(devProfile.location, DEVELOPER_DEFAULTS.profile.location, 100);
const profileStatus = textValue(devProfile.status, DEVELOPER_DEFAULTS.profile.status, 100);
const initials = profileName.split(/\s+/).filter(Boolean).slice(0, 2).map((part) => part[0]?.toUpperCase() || '').join('') || 'AP';
const profilePhoto = safeImage(devProfile.photo) || safeImage(alfredo?.foto) || safeImage(
  gallery.find((item: any) => String(item?.caption || item?.title || '').toLowerCase().includes('alfredo'))?.src,
);

const cmsEyebrow = textValue(pageContent.eyebrow, 'DEVELOPER / PROFILE', 100);
const cmsHeadline = textValue(pageContent.headline, 'Perjalanan Developer', 180);
const cmsIntro = textValue(pageContent.intro, G.deskripsi || '', 2500);
const cmsStory = textValue(pageContent.devIntroText, 'Cerita perjalanan belajar, membangun, dan memahami teknologi melalui eksperimen, proyek, serta proses pemecahan masalah.', 4000);
const developerQuote = textValue(pageContent.quote, 'Kode yang baik bukan hanya yang bekerja, tetapi juga bisa dibaca dan dipahami orang lain setahun kemudian.', 1000);

const cmsTaglines = Array.isArray(pageContent.taglines)
  ? pageContent.taglines.filter((item: unknown): item is string => typeof item === 'string' && item.trim().length > 0).slice(0, 8).map((item) => item.trim())
  : [];
const customTyping = Array.isArray(devContent.typing)
  ? devContent.typing.filter((item: unknown): item is string => typeof item === 'string' && item.trim().length > 0).slice(0, 12)
  : [];
const typingTaglines = Array.from(new Set([...cmsTaglines, ...customTyping, ...DEVELOPER_DEFAULTS.typing]));
const focusCards = normalizeObjects(devContent.focusCards, DEVELOPER_DEFAULTS.focusCards, ['title', 'description', 'icon'], 12);
const hardSkills = normalizeObjects(devContent.hardSkills, DEVELOPER_DEFAULTS.hardSkills, ['name', 'percent'], 20);
const softSkills = normalizeObjects(devContent.softSkills, DEVELOPER_DEFAULTS.softSkills, ['name', 'percent'], 20);
const draftProjects = normalizeObjects(devContent.projects, DEVELOPER_DEFAULTS.projects, ['title', 'description', 'icon', 'tag', 'status', 'href'], 30);
const projects = [
  ...draftProjects,
  {
    icon: '🌐', tag: 'Astro · Supabase', title: 'Website Kelas TKJ XII-9',
    description: 'Website kelas yang menyatukan informasi, profil anggota, struktur organisasi, galeri, dan halaman kompetensi dalam satu pengalaman responsif. Proyek ini menggunakan Astro dengan integrasi data situs dan penyimpanan yang dikonfigurasi.',
    status: 'PROJECT / WEBSITE', href: '/',
  },
];
const motivations = normalizeObjects(devContent.motivation, DEVELOPER_DEFAULTS.motivation, ['title', 'description'], 30);
const journeys = normalizeObjects(devContent.journey, DEVELOPER_DEFAULTS.journey, ['title', 'description'], 30);
const principles = normalizeObjects(devContent.principles, DEVELOPER_DEFAULTS.principles, ['title', 'description', 'icon'], 20);
const quoteCards = normalizeObjects(devContent.quotes, DEVELOPER_DEFAULTS.quotes, ['text', 'author'], 20);
quoteCards.push({ text: developerQuote, author: 'Catatan pengembang' });
const educationCards = normalizeObjects(devContent.education, DEVELOPER_DEFAULTS.education, ['title', 'category'], 20);
const noteCards = normalizeObjects(devContent.notes, DEVELOPER_DEFAULTS.notes, ['title', 'description', 'category'], 20);
const contactMethods = normalizeObjects(devContent.contacts, DEVELOPER_DEFAULTS.contacts, ['label', 'value', 'icon', 'href', 'copy'], 12)
  .map((item) => ({ ...item, href: safeHref(item.href), copy: typeof item.copy === 'string' ? item.copy : item.value }));

const personalSkills = Array.isArray(alfredoMember?.skills)
  ? alfredoMember.skills.map((skill: any) => typeof skill === 'string' ? skill : skill?.nama || skill?.name || skill?.label)
      .filter((skill: unknown) => typeof skill === 'string' && skill.trim()).slice(0, 30)
  : [];
const websiteStack = ['Astro', 'Supabase', 'Cloudflare', 'JavaScript', 'CSS'];
const marqueeSkills = Array.from(new Set(['JavaScript', 'Node.js', 'HTML', 'CSS', 'Baileys', 'React', 'Python', 'Linux', ...websiteStack]));
const experienceEntries = normalizeObjects(pageContent.experiences, [], ['title', 'period', 'date', 'organization', 'description'], 30);
const socialPlatforms = [
  { key: 'instagram', label: 'Instagram', icon: '📷' },
  { key: 'youtube', label: 'YouTube', icon: '▶️' },
  { key: 'tiktok', label: 'TikTok', icon: '🎵' },
  { key: 'github', label: 'GitHub', icon: '⌘' },
  { key: 'linkedin', label: 'LinkedIn', icon: 'in' },
  { key: 'website', label: 'Website', icon: '🌐' },
];
const classSocialLinks = socialPlatforms.flatMap((platform) => {
  const href = safeExternalUrl(G.sosmed?.[platform.key]);
  return href ? [{ ...platform, href }] : [];
});
const personalSocialLinks = socialPlatforms.flatMap((platform) => {
  const href = safeExternalUrl(alfredoMember?.social?.[platform.key]);
  return href ? [{ ...platform, href }] : [];
});

const isSectionEnabled = (key: string) => {
  const aliases = key === 'about' || key === 'profile' ? ['profile', 'story'] : [key];
  const rows = aliases.map((alias) => sectionConfig.find((section: any) => section.section_key === alias)).filter(Boolean);
  return rows.length ? rows[0].enabled !== false : true;
};
const pageDefinitions: Array<{ id: string; label: string; icon: string; key: string }> = [
  { id: 'about', label: 'Tentang', icon: '◐', key: 'profile' },
  { id: 'skills', label: 'Skill', icon: '◇', key: 'skills' },
  { id: 'work', label: 'Karya', icon: '▤', key: 'work' },
  { id: 'motivasi', label: 'Motiv', icon: '✦', key: 'motivation' },
  { id: 'contact', label: 'Kontak', icon: '✉', key: 'contact' },
  { id: 'philosophy', label: 'Filosofi', icon: '⌁', key: 'philosophy' },
  { id: 'pengalaman', label: 'Pengalaman', icon: '🎖️', key: 'experience' },
  { id: 'quotes', label: 'Kutipan', icon: '❝', key: 'quotes' },
  { id: 'edukasi', label: 'Edukasi', icon: '▧', key: 'education' },
  { id: 'notes', label: 'Catatan', icon: '✎', key: 'notes' },
];
const getSectionOrder = (key: string, fallback: number) => {
  const row = sectionConfig.find((section: any) => section.section_key === key) || (key === 'profile' ? sectionConfig.find((section: any) => section.section_key === 'story') : null);
  return row ? Number(row.sort_order) || 0 : fallback;
};
const visiblePages = pageDefinitions
  .map((page, index) => ({ ...page, _order: getSectionOrder(page.key, index) }))
  .filter((page) => isSectionEnabled(page.key))
  .sort((a, b) => a._order - b._order)
  .map(({ _order: _ignored, ...page }) => page);
const mainNavIds = ['about', 'skills', 'work', 'motivasi', 'contact'];
const mainNav = visiblePages.filter((page) => mainNavIds.includes(page.id));
const extraNav = visiblePages.filter((page) => !mainNavIds.includes(page.id));
const hasVisiblePages = visiblePages.length > 0;
const initialPage = visiblePages[0]?.id || 'about';
const homePageId = mainNav[0]?.id || initialPage;
const currentPageName = `${G.namaKelas || 'TKJ XII-9'} · ${G.namaSekolah || 'SMK Muhammadiyah Belitang'}`;
---

<DeveloperLayout
  title="Portofolio Pengembang — TKJ XII-9"
  description="Profil, karya, perjalanan belajar, prinsip, dan catatan pengembang website kelas TKJ XII-9."
  settings={G}
  seo={pageSEO}
  profileName={profileName}
  profileRole={profileRole}
>
  <div class="wrap">
    <div class="card" id="developer-card" data-taglines={JSON.stringify(typingTaglines)}>
      <div class="halftone" aria-hidden="true"></div>
      <div id="scroll-progress" aria-hidden="true"></div>
      <div class="intro-burst" aria-hidden="true">BAM!</div>

      <header class="navbar">
        <nav class="nav-links" aria-label="Navigasi portofolio">
          {mainNav.map((page) => (
            <button class:list={['nav-item', { on: page.id === initialPage }]} type="button" data-page={page.id} data-nav={page.id} aria-current={page.id === initialPage ? 'page' : 'false'}>
              <span class="nav-ico" aria-hidden="true">{page.icon}</span>{page.label}
            </button>
          ))}
        </nav>
        <button class="menu-btn" type="button" data-action="menu" aria-label="Buka menu halaman" aria-controls="drawer" aria-expanded="false">☰</button>
      </header>

      <main class="content" id="portfolio-main">
        {!hasVisiblePages && <div class="empty-state" role="status"><div class="empty-icon">◌</div><div class="empty-text">Halaman sedang disusun ulang oleh pengelola.</div></div>}
        {isSectionEnabled('profile') && (
          <section class:list={['page', { active: initialPage === 'about' }]} id="page-about" aria-label="Tentang pengembang" hidden={initialPage !== 'about'}>
            <div class="hero-bento">
              <div class="bento-tile bento-avatar">
                <div class="av-wrap">
                  <div class="av-ring" aria-hidden="true"></div>
                  <div class="av">
                    {profilePhoto ? <img src={profilePhoto} alt={`Foto profil ${profileName}`} loading="eager" decoding="async" /> : <span>{initials}</span>}
                  </div>
                  <div class="status-dot" aria-label="Profil pengembang"></div>
                </div>
              </div>
              <div class="bento-tile bento-name">
                <div class="name" id="nameEl">{profileName}</div>
                <div class="role">{profileRole}</div>
              </div>
              <div class="bento-tile bento-loc"><span aria-hidden="true">📍</span><span>{profileLocation}</span></div>
              <div class="bento-tile bento-status"><span class="dot" aria-hidden="true"></span><span>{profileStatus}</span></div>
              <div class="bento-tile bento-typing"><div class="typing" id="typing" aria-label="Semboyan pengembang">{typingTaglines[0] || 'Keep learning.'}</div></div>
              <div class="bento-tile bento-actions">
                {visiblePages.some((page) => page.id === 'contact') && <button class="btn btn-primary" type="button" data-page="contact" data-nav="contact" data-shake data-sound>💬 Hubungi</button>}
                {visiblePages.some((page) => page.id === 'work') && <button class="btn btn-outline" type="button" data-page="work" data-nav="work" data-sound>💼 Karya</button>}
              </div>
            </div>

            <section class="section" aria-labelledby="about-heading">
              <div class="cms-page-intro" data-reveal>
                <div class="cms-page-kicker">{cmsEyebrow}</div>
                <h1 class="cms-page-headline" id="about-heading">{cmsHeadline}</h1>
              </div>
              <div class="sec-title" data-kicker="Chapter I">Tentang pengembang</div>
              <p class="bio-extra" data-reveal>Berkenalan dengan orang di balik proses pengembangan website ini.</p>
              <div class="bio" data-reveal>{textValue(devProfile.bio, DEVELOPER_DEFAULTS.profile.bio, 3000)}</div>
              {cmsIntro && <p class="bio-extra" data-reveal>{cmsIntro}</p>}
              <div class="facts-grid">
                <div class="fact" data-reveal><div class="f-icon">📍</div><div class="f-info"><span class="f-label">Location</span><span class="f-val">{profileLocation}</span></div></div>
                <div class="fact" data-reveal><div class="f-icon">🗣️</div><div class="f-info"><span class="f-label">Languages</span><span class="f-val">{textValue(devProfile.languages, DEVELOPER_DEFAULTS.profile.languages, 80)}</span></div></div>
                <div class="fact" data-reveal><div class="f-icon">🎯</div><div class="f-info"><span class="f-label">Focus</span><span class="f-val">{textValue(devProfile.focus, DEVELOPER_DEFAULTS.profile.focus, 100)}</span></div></div>
                <div class="fact" data-reveal><div class="f-icon">☕</div><div class="f-info"><span class="f-label">Fuel</span><span class="f-val">{textValue(devProfile.fuel, DEVELOPER_DEFAULTS.profile.fuel, 80)}</span></div></div>
              </div>
              <div class="marquee-wrap" aria-label="Teknologi yang menjadi perhatian"><div class="marquee">
                {[...marqueeSkills, ...marqueeSkills].map((skill) => <span>{skill}</span>)}
              </div></div>
              <div class="sub-title">Focus</div>
              {focusCards.map((item) => (
                <article class="focus-card" data-reveal data-glitch={item.title === 'Learning German' ? '' : undefined}>
                  <div class="focus-icon">{item.icon || '✦'}</div>
                  <div class="focus-info"><div class="focus-title">{item.title}</div><div class="focus-desc">{item.description}</div></div>
                </article>
              ))}
              <div class="sub-title">Cerita pengembangan</div>
              <p class="story-copy" data-reveal>{cmsStory}</p>
              <div class="sub-title">THE APPROACH</div>
              <article class="focus-card approach-card" data-reveal>
                <div class="focus-icon">⌘</div>
                <div class="focus-info"><div class="focus-title">Memahami sebelum mengembangkan.</div><div class="focus-desc">Proses belajar tidak berhenti pada membuat sesuatu berjalan. Memahami alasan di balik struktur, alur, dan keputusan teknis adalah bagian dari proses pengembangan itu sendiri.</div><code>const nextStep = learn();</code></div>
              </article>
              <div class="profile-meta">
                <span>🏫 {G.namaSekolah || 'SMK Muhammadiyah Belitang'}</span>
                {G.tahunAjaran && <span>📅 {G.tahunAjaran}</span>}
              </div>
            </section>
          </section>
        )}

        {isSectionEnabled('skills') && (
          <section class:list={['page', { active: initialPage === 'skills' }]} id="page-skills" aria-label="Keahlian" hidden={initialPage !== 'skills'}>
            <section class="section">
              <div class="sec-title" data-kicker="Chapter II">Teknologi & kompetensi</div>
              <p class="stack-note">Teknologi yang teridentifikasi pada implementasi website ini.</p>
              <div class="sub-title">Hard Skills</div>
              <div class="skills-radial-grid">
                {hardSkills.map((skill) => (
                  <div class="skill-radial" data-reveal>
                    <div class="skill-radial-ring">
                      <svg viewBox="0 0 100 100" aria-hidden="true">
                        <circle class="sr-track" cx="50" cy="50" r="42" />
                        <circle class="sr-progress" cx="50" cy="50" r="42" style={`--pct:${skill.percent ?? 0}`} data-countup={skill.percent ?? 0} />
                      </svg>
                      <div class="sr-center"><span class="sr-val">0</span><span class="sr-pct">%</span></div>
                    </div>
                    <div class="sr-name">{skill.name}</div>
                  </div>
                ))}
              </div>
              <div class="sub-title">Soft Skills</div>
              <div class="skills-radial-grid">
                {softSkills.map((skill) => (
                  <div class="skill-radial" data-reveal>
                    <div class="skill-radial-ring">
                      <svg viewBox="0 0 100 100" aria-hidden="true">
                        <circle class="sr-track" cx="50" cy="50" r="42" />
                        <circle class="sr-progress" cx="50" cy="50" r="42" style={`--pct:${skill.percent ?? 0}`} data-countup={skill.percent ?? 0} />
                      </svg>
                      <div class="sr-center"><span class="sr-val">0</span><span class="sr-pct">%</span></div>
                    </div>
                    <div class="sr-name">{skill.name}</div>
                  </div>
                ))}
              </div>
              <p class="skill-disclaimer">Angka persentase adalah penilaian reflektif pada draft portofolio, bukan hasil uji kompetensi atau sertifikasi.</p>
              {personalSkills.length > 0 && <><div class="sub-title">Keahlian dari data anggota CMS</div><div class="skill-chips">{personalSkills.map((skill) => <span>{skill}</span>)}</div></>}
              <div class="sub-title">Stack website kelas</div>
              <p class="stack-note">Teknologi di bawah berasal dari implementasi website kelas, bukan klaim tingkat kemahiran pribadi.</p>
              <div class="skill-chips">{websiteStack.map((technology) => <span>{technology}</span>)}</div>
            </section>
          </section>
        )}

        {isSectionEnabled('work') && (
          <section class:list={['page', { active: initialPage === 'work' }]} id="page-work" aria-label="Karya dan proyek" hidden={initialPage !== 'work'}>
            <section class="section">
              <div class="sec-title" data-kicker="Chapter III">Karya & proyek</div>
              <p class="stack-note">Proyek yang sedang menjadi rumah bagi halaman portofolio ini.</p>
              <div class="projects-grid">
                {projects.map((project, index) => (
                  <article class="proj" data-reveal data-sound>
                    <div class="proj-header">{project.icon || '✦'}<span class="proj-tag">{project.tag || (index === 3 ? 'Astro' : 'Project')}</span></div>
                    <div class="proj-body">
                      <div class="proj-status">{project.status || 'SELECTED WORK'}</div>
                      <div class="proj-title">{project.title}</div>
                      <div class="proj-desc">{project.description}</div>
                      {Array.isArray(project.tags) && <div class="project-tags">{project.tags.filter((tag: unknown) => typeof tag === 'string').slice(0, 10).map((tag: string) => <span>{tag}</span>)}</div>}
                      {project.href && safeHref(project.href) && <a class="project-link" href={safeHref(project.href) || '#'}>Lihat proyek ↗</a>}
                      {index === 3 && <div class="project-tags">{websiteStack.map((tag) => <span>{tag}</span>)}</div>}
                    </div>
                  </article>
                ))}
              </div>
            </section>
          </section>
        )}

        {isSectionEnabled('motivation') && (
          <section class:list={['page', { active: initialPage === 'motivasi' }]} id="page-motivasi" aria-label="Motivasi dan perjalanan" hidden={initialPage !== 'motivasi'}>
            <section class="section">
              <div class="sec-title" data-kicker="Chapter IV">Motivasi</div>
              <div class="timeline">
                {motivations.map((item) => <article class="timeline-item" data-reveal><div class="timeline-dot"></div><div class="timeline-title">{item.title}</div><div class="timeline-desc">{item.description}</div></article>)}
              </div>
              <div class="sub-title journey-title">Perjalanan belajar</div>
              <p class="journey-intro">Potongan proses yang membentuk cara pandang terhadap teknologi dan pengembangan.</p>
              <div class="timeline journey-timeline">
                {journeys.map((item, index) => <article class="timeline-item" data-reveal><div class="timeline-dot"></div><div class="timeline-title"><span class="journey-index">{String(index + 1).padStart(2, '0')}</span>{item.title}</div><div class="timeline-desc">{item.description}</div></article>)}
              </div>
            </section>
          </section>
        )}

        {isSectionEnabled('contact') && (
          <section class:list={['page', { active: initialPage === 'contact' }]} id="page-contact" aria-label="Kontak" hidden={initialPage !== 'contact'}>
            <section class="section">
              <div class="sec-title" data-kicker="Chapter V">Kontak & media sosial</div>
              <p class="bio-extra">Saluran publik yang tercatat pada konfigurasi website.</p>
              <div class="contacts-list">
                {contactMethods.map((item) => (
                  <article class="ctc" data-sound>
                    <div class="ctc-left" data-link={item.href || undefined}>
                      <div class="ctc-icon">{item.icon || '✉️'}</div>
                      <div class="ctc-info"><span class="ctc-label">{item.label}</span><span class="ctc-val">{item.value}</span></div>
                    </div>
                    {item.copy && <button class="ctc-action" type="button" data-copy={item.copy} aria-label={`Salin ${item.label}`}>📋</button>}
                  </article>
                ))}
              </div>
              {personalSocialLinks.length > 0 && <><div class="sub-title">Profil pengembang</div><div class="socials">{personalSocialLinks.map((item) => <a class="soc" href={item.href} target="_blank" rel="noopener noreferrer" aria-label={item.label} data-sound>{item.icon}</a>)}</div></>}
              {classSocialLinks.length > 0 && <><div class="sub-title">Media sosial kelas</div><div class="socials">{classSocialLinks.map((item) => <a class="soc" href={item.href} target="_blank" rel="noopener noreferrer" aria-label={`${item.label} kelas`} data-sound>{item.icon}</a>)}</div></>}
            </section>
          </section>
        )}

        {isSectionEnabled('philosophy') && (
          <section class:list={['page', { active: initialPage === 'philosophy' }]} id="page-philosophy" aria-label="Filosofi pengembang" hidden={initialPage !== 'philosophy'}>
            <section class="section">
              <button class="back-btn" type="button" data-page={homePageId} data-nav={homePageId}>← BACK</button>
              <div class="sec-title" data-kicker="Appendix / Principles">Filosofi & catatan</div>
              <p class="bio-extra">Prinsip yang tercermin dalam cerita pengembangan di halaman ini.</p>
              <blockquote class="philosophy-quote" data-reveal>“{developerQuote}”</blockquote>
              <div class="principles-grid">
                {principles.map((item) => <article class="principle-card" data-reveal><div class="principle-icon">{item.icon || '✦'}</div><h3>{item.title}</h3><p>{item.description}</p></article>)}
              </div>
              <div class="sub-title">Prinsip kerja</div>
              <p class="story-copy">Pahami masalah, periksa asumsi, lalu pilih struktur yang dapat diuji dan dipelihara. Tampilan adalah bagian dari produk, bukan pengganti fondasi.</p>
            </section>
          </section>
        )}

        {isSectionEnabled('experience') && (
          <section class:list={['page', { active: initialPage === 'pengalaman' }]} id="page-pengalaman" aria-label="Pengalaman" hidden={initialPage !== 'pengalaman'}>
            <section class="section">
              <button class="back-btn" type="button" data-page={homePageId} data-nav={homePageId}>← BACK</button>
              <div class="sec-title" data-kicker="Appendix A">Pengalaman</div>
              <p class="bio-extra">Catatan yang tersimpan pada konten halaman.</p>
              {experienceEntries.length > 0 ? <div class="experience-list">{experienceEntries.map((entry) => <article class="article-card" data-reveal><div class="article-category">{entry.period || entry.date || 'PENGALAMAN'}</div><div class="article-title">{entry.title}</div>{entry.organization && <p class="experience-org">{entry.organization}</p>}{entry.description && <div class="article-body"><p>{entry.description}</p></div>}</article>)}</div> : <div class="empty-state"><div class="empty-icon">🎖️</div><div class="empty-text">Belum ada catatan.<br />Ruang ini menunggu pencapaianmu.</div></div>}
            </section>
          </section>
        )}

        {isSectionEnabled('quotes') && (
          <section class:list={['page', { active: initialPage === 'quotes' }]} id="page-quotes" aria-label="Kutipan" hidden={initialPage !== 'quotes'}>
            <section class="section">
              <button class="back-btn" type="button" data-page={homePageId} data-nav={homePageId}>← BACK</button>
              <div class="sec-title" data-kicker="Appendix B">Kutipan</div>
              <div class="quote-carousel" data-carousel data-auto="true">
                <div class="quote-track">
                  {quoteCards.map((quote) => <article class="quote-card"><div class="quote-text">{quote.text}</div><div class="quote-author">{quote.author}</div></article>)}
                </div>
                <div class="quote-dots">{quoteCards.map((_quote, index) => <button type="button" data-dot={index} class:list={{ on: index === 0 }} aria-label={`Kutipan ${index + 1}`} aria-pressed={index === 0 ? 'true' : 'false'}></button>)}</div>
              </div>
            </section>
          </section>
        )}

        {isSectionEnabled('education') && (
          <section class:list={['page', { active: initialPage === 'edukasi' }]} id="page-edukasi" aria-label="Edukasi" hidden={initialPage !== 'edukasi'}>
            <section class="section">
              <button class="back-btn" type="button" data-page={homePageId} data-nav={homePageId}>← BACK</button>
              <div class="sec-title" data-kicker="Appendix C">Edukasi</div>
              <div class="edukasi-grid">
                {educationCards.map((article) => <article class="article-card" data-reveal><div class="article-category">{article.category || 'Catatan'}</div><div class="article-title">{article.title}</div><div class="article-body">{(article.paragraphs || []).map((paragraph: string) => <p>{paragraph}</p>)}</div></article>)}
              </div>
            </section>
          </section>
        )}

        {isSectionEnabled('notes') && (
          <section class:list={['page', { active: initialPage === 'notes' }]} id="page-notes" aria-label="Catatan" hidden={initialPage !== 'notes'}>
            <section class="section">
              <button class="back-btn" type="button" data-page={homePageId} data-nav={homePageId}>← BACK</button>
              <div class="sec-title" data-kicker="Appendix D">Catatan</div>
              <div class="notes-grid">
                {noteCards.map((note) => <article class="article-card" data-reveal><div class="article-category">{note.category || 'Notes'}</div><div class="article-title">{note.title}</div><div class="article-body"><p>{note.description}</p></div></article>)}
              </div>
            </section>
          </section>
        )}
      </main>

      <footer class="footer">
        <div id="clock" aria-label="Waktu Indonesia Barat"></div>
        <div class="footer-meta">{profileName} · {G.namaKelas || 'TKJ XII-9'} · BRUTALIST EDITION</div>
        <p class="footer-school">{currentPageName}</p>
      </footer>

      <div class="overlay" id="overlay" aria-hidden="true"></div>
      <aside class="drawer" id="drawer" aria-label="Menu tambahan" aria-hidden="true">
        <div class="dr-hdr"><div class="dr-title">Menu</div><button class="dr-close" type="button" data-action="close-menu" aria-label="Tutup menu">×</button></div>
        <div class="dr-section">
          <div class="dr-label">Halaman tambahan</div>
          <div class="dr-grid extra">
            {extraNav.map((page) => <button class="extra-btn" type="button" data-page={page.id} data-nav={page.id}><span>{page.icon}</span>{page.label}</button>)}
          </div>
        </div>
        <div class="dr-section"><div class="dr-label">Tema</div><div class="locked-theme"><span class="lock">🔒</span>BRUTALIST LOCKED</div></div>
      </aside>
      <div class="toast" id="toast" role="status" aria-live="polite">COPIED!</div>
    </div>
  </div>
</DeveloperLayout>
