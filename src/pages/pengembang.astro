  .dp-project-card { display: grid; grid-template-columns: minmax(250px, 0.95fr) minmax(0, 1.05fr); overflow: hidden; border: 1px solid var(--dp-border); border-radius: 22px; background: var(--dp-panel); box-shadow: var(--dp-shadow); }
  .dp-project-visual { display: grid; place-items: center; min-height: 310px; padding: 28px; overflow: hidden; background: radial-gradient(circle at 28% 20%, rgba(149, 117, 255, 0.28), transparent 48%), radial-gradient(circle at 85% 75%, rgba(84, 223, 255, 0.2), transparent 44%), rgba(255, 255, 255, 0.025); }
  .dp-project-window { width: min(100%, 370px); overflow: hidden; border: 1px solid rgba(255, 255, 255, 0.22); border-radius: 14px; background: #0d1020; box-shadow: 0 24px 55px rgba(0, 0, 0, 0.3); transform: perspective(850px) rotateY(-7deg) rotateX(3deg); }
  .dp-window-bar { display: flex; align-items: center; gap: 5px; height: 34px; padding: 0 10px; border-bottom: 1px solid rgba(255, 255, 255, 0.08); background: #171a2e; }
