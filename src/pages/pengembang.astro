---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getPageContext } from '../lib/data';

const { site: G, sections: sectionConfig, content: pageContent } = await getPageContext('/pengembang', Astro.request);
const storyVisible = sectionConfig.find((item) => item.section_key === 'story')?.enabled !== false;

const alfredoMember = (G.namaSiswa || []).find((member) =>
  typeof member?.nama === 'string' && member.nama.toLowerCase().includes('alfredo'),
);
const alfredoOrganization = (G.strukturOrg || []).find((member) =>
  typeof member?.nama === 'string' && member.nama.toLowerCase().includes('alfredo'),
);
const alfredo = alfredoOrganization || alfredoMember || null;
const profileName = alfredo?.nama || alfredoMember?.nama || 'Pengembang TKJ XII-9';
const profileRole = alfredo?.jabatan || alfredoMember?.jabatan || pageContent.role || 'Pengembang Website';
const profilePhotoCandidate = alfredo?.foto || alfredoMember?.foto ||
  (G.galeri || []).find((item) => String(item?.caption || item?.title || '').toLowerCase().includes('alfredo'))?.src;
const profilePhoto = typeof profilePhotoCandidate === 'string' &&
  (profilePhotoCandidate.startsWith('https://') || (profilePhotoCandidate.startsWith('/') && !profilePhotoCandidate.startsWith('//')))
  ? profilePhotoCandidate
  : null;
const initials = profileName.split(/\s+/).filter(Boolean).slice(0, 2).map((part) => part[0]?.toUpperCase() || '').join('') || 'TK';

const cmsDeveloperEyebrow = pageContent.eyebrow || 'DEVELOPER PROFILE';
const cmsDeveloperHeadline = pageContent.headline || 'Perjalanan Developer';
const cmsDeveloperIntro = pageContent.intro || G.deskripsi || '';
const cmsDeveloperStory = pageContent.devIntroText || 'Cerita perjalanan belajar, membangun, dan memahami teknologi melalui eksperimen, proyek, serta proses pemecahan masalah.';
const taglineValues = Array.isArray(pageContent.taglines)
  ? pageContent.taglines.filter((value) => typeof value === 'string' && value.trim()).slice(0, 5)
  : [];
const taglines = taglineValues.length ? taglineValues : [cmsDeveloperHeadline];

const personalSkills = Array.isArray(alfredoMember?.skills)
  ? alfredoMember.skills.map((skill) => typeof skill === 'string' ? skill : skill?.nama || skill?.name || skill?.label).filter((skill) => typeof skill === 'string' && skill.trim())
  : [];

// Stack di bawah berasal dari dependensi dan implementasi proyek website ini,
// bukan klaim level kemampuan pribadi.
const websiteStack = ['Astro', 'Supabase', 'Cloudflare', 'JavaScript', 'CSS'];

const safeExternalUrl = (value: unknown) => {
  if (typeof value !== 'string' || value.length > 2048) return null;
  try {
    const url = new URL(value);
    return url.protocol === 'https:' && !url.username && !url.password ? url.href : null;
  } catch {
    return null;
  }
};

const socialPlatforms = [
  { key: 'instagram', label: 'Instagram', icon: 'fa-brands fa-instagram' },
  { key: 'youtube', label: 'YouTube', icon: 'fa-brands fa-youtube' },
  { key: 'tiktok', label: 'TikTok', icon: 'fa-brands fa-tiktok' },
  { key: 'github', label: 'GitHub', icon: 'fa-brands fa-github' },
  { key: 'linkedin', label: 'LinkedIn', icon: 'fa-brands fa-linkedin' },
  { key: 'website', label: 'Website', icon: 'fa-solid fa-globe' },
];
const classSocialLinks = socialPlatforms.flatMap((platform) => {
  const href = safeExternalUrl(G.sosmed?.[platform.key]);
  return href ? [{ ...platform, href }] : [];
});
const personalSocialLinks = socialPlatforms.flatMap((platform) => {
  const href = safeExternalUrl(alfredoMember?.social?.[platform.key]);
  return href ? [{ ...platform, href }] : [];
});
const experienceEntries = Array.isArray(pageContent.experiences)
  ? pageContent.experiences.filter((item) => item && typeof item.title === 'string' && item.title.trim())
  : [];
const tabs = [
  { id: 'about', label: 'Tentang', icon: 'fa-user' },
  { id: 'technology', label: 'Teknologi', icon: 'fa-layer-group' },
  { id: 'projects', label: 'Karya', icon: 'fa-code' },
  { id: 'journey', label: 'Perjalanan', icon: 'fa-route' },
  { id: 'philosophy', label: 'Filosofi', icon: 'fa-lightbulb' },
  ...(experienceEntries.length ? [{ id: 'experience', label: 'Pengalaman', icon: 'fa-briefcase' }] : []),
  ...((classSocialLinks.length || personalSocialLinks.length) ? [{ id: 'contact', label: 'Kontak', icon: 'fa-paper-plane' }] : []),
];
const developerQuote = typeof pageContent.quote === 'string' && pageContent.quote.trim()
  ? pageContent.quote
  : 'Kode yang baik bukan hanya yang bekerja — tapi yang bisa dibaca dan dipahami orang lain setahun kemudian.';
---

<Layout
  title="Pengembang Website — TKJ XII-9 SMK Muhammadiyah Belitang"
  description="Profil pengembang dan perjalanan pembuatan website resmi kelas TKJ XII-9 SMK Muhammadiyah Belitang."
>
  <Header />
  <main id="main-content" class="developer-main" style={`display:${storyVisible ? '' : 'none'}`}>
    <div class="developer-portfolio" data-theme="dark" data-taglines={JSON.stringify(taglines)}>
      <canvas class="dp-particles" aria-hidden="true"></canvas>
      <div class="dp-grid-overlay" aria-hidden="true"></div>
      <div class="dp-glow dp-glow-one" aria-hidden="true"></div>
      <div class="dp-glow dp-glow-two" aria-hidden="true"></div>

      <div class="dp-inner">
        <section class="dp-hero" aria-labelledby="developer-name">
          <div class="dp-hero-copy">
            <span class="dp-eyebrow"><span class="dp-eyebrow-dot"></span>{cmsDeveloperEyebrow}</span>
            <div class="dp-avatar-wrap">
              <span class="dp-avatar-pulse" aria-hidden="true"></span>
              <span class="dp-avatar-orbit" aria-hidden="true"></span>
              <span class="dp-avatar-ring" aria-hidden="true"></span>
              <div class="dp-avatar">
                {profilePhoto ? (
                  <img src={profilePhoto} alt={`Foto profil ${profileName}`} loading="eager" decoding="async" />
                ) : (
                  <span aria-hidden="true">{initials}</span>
                )}
              </div>
              <span class="dp-avatar-status" aria-hidden="true"></span>
            </div>
            <p class="dp-role">{profileRole} <span aria-hidden="true">·</span> TKJ XII-9</p>
            <h1 id="developer-name" class="dp-name">{profileName}</h1>
            <p class="dp-headline">{cmsDeveloperHeadline}</p>
            <p class="dp-tagline"><span id="dp-typewriter">{taglines[0]}</span><span class="dp-caret" aria-hidden="true"></span></p>
            <div class="dp-hero-actions">
              <button class="dp-button dp-button-primary" type="button" data-open-tab="projects">
                <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
                Lihat karya
              </button>
              {tabs.some((tab) => tab.id === 'contact') && (
                <button class="dp-button dp-button-quiet" type="button" data-open-tab="contact">
                  <i class="fa-regular fa-paper-plane" aria-hidden="true"></i>
                  Media sosial
                </button>
              )}
            </div>
            <div class="dp-hero-meta">
              <span><i class="fa-solid fa-graduation-cap" aria-hidden="true"></i>{G.namaSekolah || 'SMK Muhammadiyah Belitang'}</span>
              {G.tahunAjaran && <span><i class="fa-regular fa-calendar" aria-hidden="true"></i>{G.tahunAjaran}</span>}
            </div>
          </div>
          <div class="dp-hero-side" aria-hidden="true">
            <div class="dp-orbit-art">
              <span class="dp-orbit-line dp-orbit-line-a"></span>
              <span class="dp-orbit-line dp-orbit-line-b"></span>
              <span class="dp-orbit-core"><i class="fa-solid fa-code"></i></span>
              <span class="dp-orbit-node dp-node-a"></span>
              <span class="dp-orbit-node dp-node-b"></span>
              <span class="dp-orbit-node dp-node-c"></span>
            </div>
            <span class="dp-side-caption">BUILD · LEARN · UNDERSTAND</span>
          </div>
        </section>

        <nav class="dp-navigation" aria-label="Navigasi portofolio">
          <div class="dp-tabs" role="tablist" aria-label="Bagian portofolio">
            {tabs.map((tab, index) => (
              <button
                class:list={["dp-tab", { active: index === 0 }]}
                id={`dp-tab-${tab.id}`}
                type="button"
                role="tab"
                aria-selected={index === 0 ? 'true' : 'false'}
                aria-controls={`dp-panel-${tab.id}`}
                tabindex={index === 0 ? 0 : -1}
                data-tab={tab.id}
              >
                <i class={`fa-solid ${tab.icon}`} aria-hidden="true"></i>
                <span>{tab.label}</span>
              </button>
            ))}
          </div>
          <div class="dp-theme-picker" role="group" aria-label="Pilih tema portofolio">
            <button class="dp-theme-button active" type="button" data-portfolio-theme="dark" aria-pressed="true" aria-label="Tema Dark">
              <i class="fa-solid fa-moon" aria-hidden="true"></i><span>Dark</span>
            </button>
            <button class="dp-theme-button" type="button" data-portfolio-theme="light" aria-pressed="false" aria-label="Tema Light">
              <i class="fa-solid fa-sun" aria-hidden="true"></i><span>Light</span>
            </button>
            <button class="dp-theme-button" type="button" data-portfolio-theme="ghost" aria-pressed="false" aria-label="Tema Ghost">
              <i class="fa-solid fa-ghost" aria-hidden="true"></i><span>Ghost</span>
            </button>
          </div>
        </nav>

        <div class="dp-panels">
          <section class="dp-panel active" id="dp-panel-about" role="tabpanel" aria-labelledby="dp-tab-about" data-panel="about">
            <div class="dp-panel-heading">
              <span class="dp-section-index">01 / PROFILE</span>
              <h2>Tentang pengembang</h2>
              <p>Berkenalan dengan orang di balik proses pengembangan website ini.</p>
            </div>
            <div class="dp-about-grid">
              <article class="dp-card dp-about-main">
                <div class="dp-card-icon"><i class="fa-regular fa-user" aria-hidden="true"></i></div>
                <h3>Gambaran singkat</h3>
                <p>{cmsDeveloperIntro}</p>
                <div class="dp-card-divider"></div>
                <h3>Catatan perjalanan</h3>
                <p>{cmsDeveloperStory}</p>
              </article>
              <aside class="dp-card dp-about-aside">
                <span class="dp-card-kicker">THE APPROACH</span>
                <h3>Memahami sebelum mengembangkan.</h3>
                <p>Proses belajar tidak berhenti pada membuat sesuatu berjalan. Memahami alasan di balik struktur, alur, dan keputusan teknis adalah bagian dari proses pengembangan itu sendiri.</p>
                <div class="dp-aside-mark"><i class="fa-solid fa-terminal" aria-hidden="true"></i><span>const nextStep = learn();</span></div>
              </aside>
            </div>
          </section>

          <section class="dp-panel" id="dp-panel-technology" role="tabpanel" aria-labelledby="dp-tab-technology" data-panel="technology" hidden>
            <div class="dp-panel-heading">
              <span class="dp-section-index">02 / TECHNOLOGY</span>
              <h2>Teknologi & kompetensi</h2>
              <p>Teknologi yang teridentifikasi pada implementasi website ini.</p>
            </div>
            <article class="dp-card dp-tech-card">
              <div class="dp-card-topline">
                <div>
                  <span class="dp-card-kicker">PROJECT STACK</span>
                  <h3>Fondasi website TKJ XII-9</h3>
                </div>
                <span class="dp-card-icon"><i class="fa-solid fa-layer-group" aria-hidden="true"></i></span>
              </div>
              <p class="dp-card-intro">Daftar ini merujuk pada dependensi dan lapisan teknologi yang digunakan proyek, bukan penilaian tingkat kemahiran pribadi.</p>
              <div class="dp-tech-list">
                {websiteStack.map((technology, index) => (
                  <span class="dp-tech-chip"><span class="dp-tech-number">0{index + 1}</span>{technology}</span>
                ))}
              </div>
            </article>
            {personalSkills.length > 0 && (
              <article class="dp-card dp-personal-skills">
                <span class="dp-card-kicker">PROFILE DATA</span>
                <h3>Keahlian yang tercatat pada profil anggota</h3>
                <div class="dp-tech-list">
                  {personalSkills.map((skill) => <span class="dp-tech-chip">{skill}</span>)}
                </div>
              </article>
            )}
          </section>

          <section class="dp-panel" id="dp-panel-projects" role="tabpanel" aria-labelledby="dp-tab-projects" data-panel="projects" hidden>
            <div class="dp-panel-heading">
              <span class="dp-section-index">03 / SELECTED WORK</span>
              <h2>Karya & proyek</h2>
              <p>Proyek yang sedang menjadi rumah bagi halaman portofolio ini.</p>
            </div>
            <article class="dp-project-card">
              <div class="dp-project-visual" aria-hidden="true">
                <div class="dp-project-window">
                  <div class="dp-window-bar"><span></span><span></span><span></span><small>tkj-xii-9 / web</small></div>
                  <div class="dp-window-content">
                    <div class="dp-window-sidebar"><i class="fa-solid fa-shapes"></i><i class="fa-solid fa-users"></i><i class="fa-solid fa-images"></i><i class="fa-solid fa-code"></i></div>
                    <div class="dp-window-main"><span class="dp-window-label">CLASS WEBSITE</span><b>TKJ XII-9</b><i></i><i></i><div class="dp-window-cards"><span></span><span></span><span></span></div></div>
                  </div>
                </div>
              </div>
              <div class="dp-project-copy">
                <span class="dp-project-status"><span></span> PROJECT WEBSITE</span>
                <h3>Website Kelas TKJ XII-9</h3>
                <p>Website kelas yang menyatukan informasi, profil anggota, struktur organisasi, galeri, dan halaman kompetensi dalam satu pengalaman yang responsif. Proyek ini menggunakan Astro dengan integrasi data situs dan layanan penyimpanan yang telah dikonfigurasi.</p>
                <div class="dp-project-tags">
                  {websiteStack.map((technology) => <span>{technology}</span>)}
                </div>
                <a class="dp-project-link" href="/" aria-label="Kunjungi website TKJ XII-9">
                  Jelajahi website <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
                </a>
              </div>
            </article>
          </section>

          <section class="dp-panel" id="dp-panel-journey" role="tabpanel" aria-labelledby="dp-tab-journey" data-panel="journey" hidden>
            <div class="dp-panel-heading">
              <span class="dp-section-index">04 / THE JOURNEY</span>
              <h2>Perjalanan belajar</h2>
              <p>Potongan proses yang membentuk cara pandang terhadap teknologi dan pengembangan.</p>
            </div>
            <div class="dp-timeline">
              <article class="dp-timeline-item">
                <span class="dp-timeline-number">01</span>
                <div><h3>Awal yang mengejutkan</h3><p>Kode pernah terlihat seperti teks acak. Ketertarikan mulai tumbuh ketika berkenalan dengan WhatsApp Bot Baileys dan mencoba memahami logika di balik sebuah perintah.</p></div>
              </article>
              <article class="dp-timeline-item">
                <span class="dp-timeline-number">02</span>
                <div><h3>Belajar dengan membongkar</h3><p>Proses belajar dimulai dengan membaca proyek yang sudah ada, memahami struktur file, mengenali modularitas, lalu mencoba mengembangkan bagian-bagiannya.</p></div>
              </article>
              <article class="dp-timeline-item">
                <span class="dp-timeline-number">03</span>
                <div><h3>AI sebagai cermin</h3><p>AI mulai digunakan bukan hanya untuk menghasilkan kode, tetapi untuk meminta penjelasan, menguji asumsi, dan membandingkan pendekatan yang berbeda.</p></div>
              </article>
              <article class="dp-timeline-item">
                <span class="dp-timeline-number">04</span>
                <div><h3>Logika sebelum tampilan</h3><p>Struktur aplikasi dan alur data menjadi perhatian utama. Tampilan yang baik perlu ditopang fondasi yang jelas dan mudah dipelihara.</p></div>
              </article>
              <article class="dp-timeline-item">
                <span class="dp-timeline-number">05</span>
                <div><h3>Memberi jarak pada masalah</h3><p>Saat menemui jalan buntu, mengambil jeda dapat membantu melihat masalah dari sudut pandang yang lebih tenang sebelum kembali mengerjakannya.</p></div>
              </article>
              <article class="dp-timeline-item">
                <span class="dp-timeline-number">06</span>
                <div><h3>Konsistensi sebagai proses</h3><p>Perkembangan tidak hanya ditentukan oleh satu hari yang produktif. Belajar, mengevaluasi, dan memperbaiki secara berulang menjadi bagian dari perjalanan.</p></div>
              </article>
            </div>
          </section>

          <section class="dp-panel" id="dp-panel-philosophy" role="tabpanel" aria-labelledby="dp-tab-philosophy" data-panel="philosophy" hidden>
            <div class="dp-panel-heading">
              <span class="dp-section-index">05 / PRINCIPLES</span>
              <h2>Filosofi & catatan</h2>
              <p>Prinsip yang tercermin dalam cerita pengembangan di halaman ini.</p>
            </div>
            <blockquote class="dp-quote-card">
              <span class="dp-quote-mark" aria-hidden="true">“</span>
              <p>{developerQuote}</p>
              <footer>— Catatan pengembang</footer>
            </blockquote>
            <div class="dp-principles-grid">
              <article class="dp-card dp-principle-card"><span class="dp-principle-icon"><i class="fa-solid fa-brain" aria-hidden="true"></i></span><h3>Pahami, jangan sekadar salin</h3><p>Gunakan alat bantu untuk memperluas pemahaman. Keputusan dan hasil akhir tetap perlu diperiksa secara kritis.</p></article>
              <article class="dp-card dp-principle-card"><span class="dp-principle-icon"><i class="fa-solid fa-diagram-project" aria-hidden="true"></i></span><h3>Struktur adalah fondasi</h3><p>Arsitektur yang jelas membuat fitur lebih mudah dikembangkan, diuji, dan dirawat ketika proyek bertambah besar.</p></article>
              <article class="dp-card dp-principle-card"><span class="dp-principle-icon"><i class="fa-solid fa-book-open" aria-hidden="true"></i></span><h3>Readability matters</h3><p>Kode perlu dapat dipahami, bukan hanya berhasil dieksekusi. Keterbacaan membantu kerja sama dan pemeliharaan.</p></article>
            </div>
          </section>

          {experienceEntries.length > 0 && (
            <section class="dp-panel" id="dp-panel-experience" role="tabpanel" aria-labelledby="dp-tab-experience" data-panel="experience" hidden>
              <div class="dp-panel-heading"><span class="dp-section-index">06 / EXPERIENCE</span><h2>Pengalaman</h2><p>Catatan yang tersimpan pada konten halaman.</p></div>
              <div class="dp-experience-list">
                {experienceEntries.map((entry) => (
                  <article class="dp-card dp-experience-item">
                    <span class="dp-card-kicker">{entry.period || entry.date || 'PENGALAMAN'}</span>
                    <h3>{entry.title}</h3>
                    {entry.organization && <p class="dp-experience-org">{entry.organization}</p>}
                    {entry.description && <p>{entry.description}</p>}
                  </article>
                ))}
              </div>
            </section>
          )}

          {(classSocialLinks.length > 0 || personalSocialLinks.length > 0) && (
            <section class="dp-panel" id="dp-panel-contact" role="tabpanel" aria-labelledby="dp-tab-contact" data-panel="contact" hidden>
              <div class="dp-panel-heading">
                <span class="dp-section-index">07 / CONNECT</span>
                <h2>Kontak & media sosial</h2>
                <p>Saluran publik yang tercatat pada konfigurasi website.</p>
              </div>
              {personalSocialLinks.length > 0 && (
                <div class="dp-social-group">
                  <div class="dp-social-heading"><h3>Profil pengembang</h3><span>PERSONAL</span></div>
                  <div class="dp-social-grid">
                    {personalSocialLinks.map((social) => (
                      <a class="dp-social-card" href={social.href} target="_blank" rel="noopener noreferrer">
                        <i class={social.icon} aria-hidden="true"></i><span>{social.label}</span><i class="fa-solid fa-arrow-up-right-from-square dp-social-arrow" aria-hidden="true"></i>
                      </a>
                    ))}
                  </div>
                </div>
              )}
              {classSocialLinks.length > 0 && (
                <div class="dp-social-group">
                  <div class="dp-social-heading"><h3>Media sosial kelas</h3><span>TKJ XII-9</span></div>
                  <div class="dp-social-grid">
                    {classSocialLinks.map((social) => (
                      <a class="dp-social-card" href={social.href} target="_blank" rel="noopener noreferrer">
                        <i class={social.icon} aria-hidden="true"></i><span>{social.label}</span><i class="fa-solid fa-arrow-up-right-from-square dp-social-arrow" aria-hidden="true"></i>
                      </a>
                    ))}
                  </div>
                </div>
              )}
            </section>
          )}
        </div>

        <footer class="dp-footer">
          <span class="dp-footer-mark"><i class="fa-solid fa-code" aria-hidden="true"></i></span>
          <p>Bagian dari website <strong>{G.namaKelas || 'TKJ XII-9'}</strong> · {G.namaSekolah || 'SMK Muhammadiyah Belitang'}</p>
          <span class="dp-footer-line"></span>
        </footer>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .developer-main {
    padding-top: var(--top-h, 72px);
    width: 100%;
  }

  .developer-portfolio {
    --dp-bg: #080914;
    --dp-bg-soft: #101225;
    --dp-panel: rgba(255, 255, 255, 0.045);
    --dp-panel-hover: rgba(255, 255, 255, 0.075);
    --dp-ink: #f6f5ff;
    --dp-ink-soft: #d4d4e5;
    --dp-muted: #a09fb7;
    --dp-faint: #77768f;
    --dp-border: rgba(255, 255, 255, 0.09);
    --dp-border-strong: rgba(255, 255, 255, 0.16);
    --dp-purple: #9575ff;
    --dp-cyan: #54dfff;
    --dp-shadow: 0 24px 70px rgba(0, 0, 0, 0.24);
    position: relative;
    isolation: isolate;
    overflow: clip;
    width: min(100% - 28px, 1180px);
    margin: 22px auto 64px;
    padding: clamp(16px, 3.4vw, 38px);
    border: 1px solid var(--dp-border);
    border-radius: 30px;
    background:
      radial-gradient(ellipse at 18% 2%, rgba(124, 92, 255, 0.15), transparent 37%),
      radial-gradient(ellipse at 92% 18%, rgba(0, 212, 255, 0.09), transparent 32%),
      var(--dp-bg);
    color: var(--dp-ink);
    box-shadow: var(--dp-shadow);
    font-family: var(--sys, Inter, ui-sans-serif, system-ui, sans-serif);
    transition: background-color 220ms ease, color 220ms ease, border-color 220ms ease;
  }

  .developer-portfolio[data-theme="light"] {
    --dp-bg: #f7f8ff;
    --dp-bg-soft: #ffffff;
    --dp-panel: rgba(255, 255, 255, 0.78);
    --dp-panel-hover: rgba(255, 255, 255, 0.96);
    --dp-ink: #19172a;
    --dp-ink-soft: #38364d;
    --dp-muted: #625f76;
    --dp-faint: #858197;
    --dp-border: rgba(36, 31, 66, 0.11);
    --dp-border-strong: rgba(63, 50, 117, 0.2);
    --dp-purple: #704ce5;
    --dp-cyan: #008eae;
    --dp-shadow: 0 22px 60px rgba(70, 64, 115, 0.12);
    background:
      radial-gradient(ellipse at 15% 0%, rgba(149, 117, 255, 0.15), transparent 38%),
