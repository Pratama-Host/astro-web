  .dp-project-status span { width: 7px; height: 7px; border-radius: 50%; background: var(--dp-cyan); box-shadow: 0 0 12px var(--dp-cyan); }
  .dp-avatar-wrap { position: relative; width: 116px; height: 116px; margin: 0 auto 22px; }
  .dp-avatar-pulse { position: absolute; inset: -5px; border-radius: 50%; background: var(--dp-purple); opacity: 0.22; filter: blur(6px); animation: dp-pulse 3.2s ease-out infinite; }
  .dp-avatar-ring { position: absolute; inset: -5px; border-radius: 50%; background: conic-gradient(from 20deg, var(--dp-purple), var(--dp-cyan), var(--dp-purple)); animation: dp-spin 8s linear infinite; }
