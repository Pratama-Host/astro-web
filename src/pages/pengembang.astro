  .dp-avatar-orbit { position: absolute; inset: -14px; border: 1px dashed var(--dp-border-strong); border-radius: 50%; animation: dp-spin-reverse 16s linear infinite; }
  .dp-avatar-orbit::after { content: ""; position: absolute; top: 8px; left: 12px; width: 7px; height: 7px; border-radius: 50%; background: var(--dp-cyan); box-shadow: 0 0 12px var(--dp-cyan); }
  .dp-avatar { position: relative; z-index: 1; width: 100%; height: 100%; display: grid; place-items: center; overflow: hidden; border: 4px solid var(--dp-bg); border-radius: 50%; background: linear-gradient(135deg, var(--dp-purple), var(--dp-cyan)); color: #fff; font-size: 2rem; font-weight: 800; letter-spacing: -0.05em; }
  .dp-avatar img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .dp-avatar-status { position: absolute; z-index: 2; right: 3px; bottom: 5px; width: 16px; height: 16px; border: 3px solid var(--dp-bg); border-radius: 50%; background: var(--dp-cyan); box-shadow: 0 0 10px color-mix(in srgb, var(--dp-cyan) 65%, transparent); }
  .dp-role { margin: 0 0 7px; color: var(--dp-cyan); font-size: 0.82rem; font-weight: 700; letter-spacing: 0.06em; }
  .dp-role span { margin: 0 5px; opacity: 0.7; }
  .dp-name { margin: 0; color: var(--dp-ink); background: linear-gradient(120deg, var(--dp-ink), var(--dp-purple) 72%, var(--dp-cyan)); background-clip: text; -webkit-background-clip: text; -webkit-text-fill-color: transparent; font-size: clamp(2rem, 5vw, 3.35rem); font-weight: 850; letter-spacing: -0.055em; line-height: 1.12; overflow-wrap: anywhere; }
  .dp-headline { margin: 11px 0 0; color: var(--dp-muted); font-size: 0.96rem; font-weight: 600; }
  .dp-tagline { min-height: 25px; margin: 12px 0 0; color: var(--dp-ink-soft); font-family: "Fira Code", ui-monospace, monospace; font-size: 0.78rem; letter-spacing: 0.01em; }
  .dp-caret { display: inline-block; width: 6px; height: 14px; margin-left: 4px; vertical-align: -2px; border-radius: 1px; background: var(--dp-cyan); animation: dp-blink 1s steps(2, start) infinite; }
  .dp-hero-actions { display: flex; justify-content: center; flex-wrap: wrap; gap: 10px; margin-top: 24px; }
