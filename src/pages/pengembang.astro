  .dp-quote-card { position: relative; margin: 0; padding: clamp(24px, 4vw, 42px); overflow: hidden; border: 1px solid var(--dp-border-strong); border-radius: 20px; background: linear-gradient(120deg, rgba(149, 117, 255, 0.14), rgba(84, 223, 255, 0.065)), var(--dp-panel); }
  .dp-quote-mark { position: absolute; top: -22px; left: 17px; color: var(--dp-purple); font-family: Georgia, serif; font-size: 6rem; line-height: 1; opacity: 0.3; }
