  .dp-navigation { position: sticky; top: calc(var(--top-h, 72px) + 8px); z-index: 40; display: flex; align-items: center; justify-content: space-between; gap: 10px; margin: 0 0 30px; padding: 8px; border: 1px solid var(--dp-border); border-radius: 17px; background: color-mix(in srgb, var(--dp-bg-soft) 84%, transparent); box-shadow: 0 8px 26px rgba(0, 0, 0, 0.1); -webkit-backdrop-filter: blur(18px); backdrop-filter: blur(18px); }
  .dp-tabs { display: flex; align-items: center; gap: 4px; min-width: 0; overflow-x: auto; scrollbar-width: none; overscroll-behavior-x: contain; }
  .dp-tabs::-webkit-scrollbar { display: none; }
  .dp-tab { display: inline-flex; flex: 0 0 auto; align-items: center; justify-content: center; gap: 8px; min-height: 42px; padding: 0 14px; border: 1px solid transparent; border-radius: 11px; background: transparent; color: var(--dp-muted); font: inherit; font-size: 0.76rem; font-weight: 750; white-space: nowrap; cursor: pointer; transition: color 160ms ease, background 160ms ease, border-color 160ms ease; }
