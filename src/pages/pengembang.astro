  .dp-social-heading > span { color: var(--dp-faint); font: 0.6rem "Fira Code", ui-monospace, monospace; letter-spacing: 0.12em; }
  .dp-social-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 10px; }
  .dp-social-card { display: flex; align-items: center; gap: 12px; min-height: 60px; padding: 13px 15px; border: 1px solid var(--dp-border); border-radius: 13px; background: var(--dp-panel); color: var(--dp-ink); font-size: 0.82rem; font-weight: 750; text-decoration: none; transition: transform 180ms ease, background 180ms ease, border-color 180ms ease; }
  .dp-social-card > i:first-child { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 9px; background: rgba(149, 117, 255, 0.14); color: var(--dp-cyan); font-size: 0.95rem; }
  .dp-social-arrow { margin-left: auto; color: var(--dp-faint); font-size: 0.65rem; }
  .dp-social-card:hover { transform: translateY(-2px); border-color: var(--dp-border-strong); background: var(--dp-panel-hover); }

  .dp-footer { display: flex; align-items: center; gap: 12px; margin-top: 42px; padding: 20px 4px 0; border-top: 1px solid var(--dp-border); color: var(--dp-faint); }
  .dp-footer-mark { display: grid; place-items: center; width: 30px; height: 30px; flex: 0 0 auto; border: 1px solid var(--dp-border); border-radius: 9px; color: var(--dp-cyan); }
  .dp-footer p { margin: 0; font-size: 0.7rem; }
  .dp-footer strong { color: var(--dp-ink-soft); }
  .dp-footer-line { flex: 1; height: 1px; background: linear-gradient(90deg, var(--dp-border-strong), transparent); }

  .developer-portfolio :focus-visible { outline: 2px solid var(--dp-cyan); outline-offset: 3px; }

  @keyframes dp-spin { to { transform: rotate(360deg); } }
  @keyframes dp-spin-reverse { to { transform: rotate(-360deg); } }
  @keyframes dp-pulse { 0% { transform: scale(0.94); opacity: 0.3; } 100% { transform: scale(1.24); opacity: 0; } }
  @keyframes dp-blink { to { opacity: 0; } }
  @keyframes dp-panel-in { from { opacity: 0; transform: translateY(9px); } to { opacity: 1; transform: translateY(0); } }

  @media (max-width: 850px) {
    .dp-hero { grid-template-columns: minmax(0, 1fr) 190px; min-height: 390px; }
    .dp-orbit-art { width: 205px; }
    .dp-orbit-core { width: 82px; height: 82px; font-size: 1.8rem; }
    .dp-navigation { align-items: stretch; flex-direction: column; }
    .dp-theme-picker { align-self: flex-end; }
    .dp-tabs { width: 100%; }
  }

  @media (max-width: 650px) {
    .developer-portfolio { width: min(100% - 16px, 1180px); margin: 12px auto 40px; padding: 12px; border-radius: 22px; }
    .dp-hero { display: block; min-height: 0; padding: 25px 7px 30px; }
    .dp-hero-side { display: none; }
    .dp-eyebrow { margin-bottom: 20px; font-size: 0.59rem; }
    .dp-avatar-wrap { width: 100px; height: 100px; margin-bottom: 20px; }
    .dp-name { font-size: clamp(1.85rem, 9vw, 2.7rem); }
    .dp-headline { font-size: 0.88rem; }
    .dp-tagline { max-width: 100%; font-size: 0.68rem; overflow-wrap: anywhere; }
    .dp-hero-actions { gap: 8px; margin-top: 20px; }
    .dp-button { min-height: 41px; padding: 0 13px; font-size: 0.73rem; }
    .dp-hero-meta { gap: 8px 13px; font-size: 0.64rem; }
    .dp-navigation { top: calc(var(--top-h, 72px) + 5px); gap: 7px; margin-bottom: 24px; padding: 6px; border-radius: 14px; }
    .dp-tab { min-height: 39px; padding: 0 11px; font-size: 0.7rem; }
    .dp-theme-picker { align-self: stretch; justify-content: center; }
    .dp-theme-button { flex: 1; justify-content: center; min-height: 31px; }
    .dp-panel-heading { margin-bottom: 17px; }
    .dp-panel-heading p { font-size: 0.8rem; }
    .dp-about-grid, .dp-project-card { grid-template-columns: 1fr; }
    .dp-about-aside { min-height: 205px; }
    .dp-project-visual { min-height: 230px; padding: 20px; }
    .dp-project-window { transform: none; }
    .dp-window-content { min-height: 160px; }
    .dp-project-copy { padding: 23px; }
    .dp-principles-grid, .dp-experience-list { grid-template-columns: 1fr; }
    .dp-principle-card { padding: 19px; }
    .dp-social-grid { grid-template-columns: 1fr; }
    .dp-footer { margin-top: 30px; }
    .dp-footer p { font-size: 0.63rem; }
  }

  @media (max-width: 360px) {
    .dp-tabs { gap: 1px; }
    .dp-tab { gap: 6px; padding: 0 9px; font-size: 0.65rem; }
    .dp-theme-button { gap: 4px; padding: 0 6px; font-size: 0.63rem; }
    .dp-hero-meta { flex-direction: column; }
  }

  @media (hover: hover) and (pointer: fine) {
    .dp-card { transition: border-color 180ms ease, background 180ms ease, transform 180ms ease; }
    .dp-card:hover { transform: translateY(-2px); border-color: var(--dp-border-strong); background: var(--dp-panel-hover); }
  }

  @media (prefers-reduced-motion: reduce) {
    .developer-portfolio *, .developer-portfolio *::before, .developer-portfolio *::after { scroll-behavior: auto !important; animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; transition-duration: 0.01ms !important; }
  }
</style>

<script>
  const portfolio = document.querySelector('.developer-portfolio');

  if (portfolio) {
    const themeButtons = Array.from(portfolio.querySelectorAll<HTMLButtonElement>('[data-portfolio-theme]'));
    const tabs = Array.from(portfolio.querySelectorAll<HTMLButtonElement>('[data-tab]'));
    const panels = Array.from(portfolio.querySelectorAll<HTMLElement>('[data-panel]'));
    const typewriter = portfolio.querySelector<HTMLElement>('#dp-typewriter');
    let configuredTaglines: string[] = [];
    try {
      const parsedTaglines = JSON.parse(portfolio.getAttribute('data-taglines') || '[]');
      if (Array.isArray(parsedTaglines)) configuredTaglines = parsedTaglines.filter((value: unknown): value is string => typeof value === 'string' && value.trim().length > 0);
    } catch { /* Keep the rendered CMS headline as fallback. */ }
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    const setTheme = (theme: string) => {
      if (!['dark', 'light', 'ghost'].includes(theme)) return;
      portfolio.setAttribute('data-theme', theme);
      themeButtons.forEach((button) => {
        const active = button.getAttribute('data-portfolio-theme') === theme;
        button.classList.toggle('active', active);
        button.setAttribute('aria-pressed', active ? 'true' : 'false');
      });
      try { localStorage.setItem('tkj-developer-theme', theme); } catch { /* Storage may be unavailable. */ }
    };

    const activateTab = (tabId: string, focus = false) => {
      const selectedTab = tabs.find((tab) => tab.getAttribute('data-tab') === tabId);
      if (!selectedTab) return;
      tabs.forEach((tab) => {
        const active = tab === selectedTab;
        tab.classList.toggle('active', active);
        tab.setAttribute('aria-selected', active ? 'true' : 'false');
        tab.tabIndex = active ? 0 : -1;
      });
      panels.forEach((panel) => {
        const active = panel.getAttribute('data-panel') === tabId;
        panel.hidden = !active;
        panel.classList.toggle('active', active);
      });
      if (focus) selectedTab.focus();
    };

    themeButtons.forEach((button) => {
      button.addEventListener('click', () => setTheme(button.getAttribute('data-portfolio-theme') || 'dark'));
    });

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => activateTab(tab.getAttribute('data-tab') || 'about'));
      tab.addEventListener('keydown', (event) => {
        const keyboardEvent = event as KeyboardEvent;
        let nextIndex = index;
        if (keyboardEvent.key === 'ArrowRight') nextIndex = (index + 1) % tabs.length;
        else if (keyboardEvent.key === 'ArrowLeft') nextIndex = (index - 1 + tabs.length) % tabs.length;
        else if (keyboardEvent.key === 'Home') nextIndex = 0;
        else if (keyboardEvent.key === 'End') nextIndex = tabs.length - 1;
        else return;
        keyboardEvent.preventDefault();
        const nextTab = tabs[nextIndex];
        activateTab(nextTab.getAttribute('data-tab') || 'about', true);
        nextTab.scrollIntoView({ block: 'nearest', inline: 'nearest' });
      });
    });

    portfolio.querySelectorAll('[data-open-tab]').forEach((button) => {
      button.addEventListener('click', () => {
        const target = button.getAttribute('data-open-tab');
        if (target) {
          activateTab(target);
          portfolio.querySelector('.dp-navigation')?.scrollIntoView({ behavior: prefersReducedMotion.matches ? 'auto' : 'smooth', block: 'start' });
        }
      });
    });

    try {
      const savedTheme = localStorage.getItem('tkj-developer-theme');
      if (savedTheme) setTheme(savedTheme);
    } catch { /* Use the default dark theme. */ }

    if (typewriter) {
      const renderedPhrase = typewriter.textContent?.trim() || '';
      const words = configuredTaglines.length ? configuredTaglines : (renderedPhrase ? [renderedPhrase] : []);
      if (prefersReducedMotion.matches || !words.length) {
        if (words[0]) typewriter.textContent = words[0];
      } else {
        let phraseIndex = 0;
        let characterIndex = 0;
        let deleting = false;
        let timer = 0;
        const type = () => {
          const current = words[phraseIndex] || renderedPhrase;
          characterIndex += deleting ? -1 : 1;
          typewriter.textContent = current.slice(0, Math.max(0, characterIndex));
          let delay = deleting ? 28 : 58;
          if (!deleting && characterIndex >= current.length) { deleting = true; delay = 1800; }
          else if (deleting && characterIndex <= 0) { deleting = false; phraseIndex = (phraseIndex + 1) % words.length; delay = 380; }
          timer = window.setTimeout(type, delay);
        };
        timer = window.setTimeout(type, 450);
        prefersReducedMotion.addEventListener?.('change', (event) => {
          if (event.matches) {
            window.clearTimeout(timer);
            typewriter.textContent = words[0] || renderedPhrase;
          }
        });
      }
    }

    const canvas = portfolio.querySelector<HTMLCanvasElement>('.dp-particles');
    const context = canvas?.getContext('2d', { alpha: true });
    if (canvas && context && !prefersReducedMotion.matches) {
      let width = 0;
      let height = 0;
      let animationFrame = 0;
      let inView = true;
      let pageVisible = document.visibilityState !== 'hidden';
      let particles: Array<{ x: number; y: number; vx: number; vy: number; radius: number }> = [];
      const pixelRatio = Math.min(window.devicePixelRatio || 1, 1.35);

      const resizeCanvas = () => {
        const rect = portfolio.getBoundingClientRect();
        width = Math.max(1, rect.width);
        height = Math.max(1, rect.height);
        canvas.width = Math.round(width * pixelRatio);
        canvas.height = Math.round(height * pixelRatio);
        context.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
        const count = width < 650 ? 11 : 19;
        particles = Array.from({ length: count }, () => ({
          x: Math.random() * width,
          y: Math.random() * height,
          vx: (Math.random() - 0.5) * 0.22,
          vy: (Math.random() - 0.5) * 0.22,
          radius: Math.random() * 1.2 + 0.55,
        }));
      };

      const draw = () => {
        if (!inView || !pageVisible || prefersReducedMotion.matches) { animationFrame = 0; return; }
        context.clearRect(0, 0, width, height);
        const lightTheme = portfolio?.getAttribute('data-theme') === 'light';
        const pointColor = lightTheme ? '91, 76, 175' : '157, 153, 220';
        particles.forEach((particle, index) => {
          particle.x += particle.vx;
          particle.y += particle.vy;
          if (particle.x < 0 || particle.x > width) particle.vx *= -1;
          if (particle.y < 0 || particle.y > height) particle.vy *= -1;
          context.beginPath();
          context.arc(particle.x, particle.y, particle.radius, 0, Math.PI * 2);
          context.fillStyle = `rgba(${pointColor}, 0.42)`;
          context.fill();
          for (let next = index + 1; next < particles.length; next += 1) {
            const other = particles[next];
            const dx = particle.x - other.x;
            const dy = particle.y - other.y;
            const distance = Math.sqrt(dx * dx + dy * dy);
            if (distance < 105) {
              context.beginPath();
              context.moveTo(particle.x, particle.y);
              context.lineTo(other.x, other.y);
              context.strokeStyle = `rgba(${pointColor}, ${0.11 * (1 - distance / 105)})`;
              context.lineWidth = 0.6;
              context.stroke();
            }
          }
        });
        animationFrame = window.requestAnimationFrame(draw);
      };

      const startAnimation = () => {
        if (!animationFrame && inView && pageVisible && !prefersReducedMotion.matches) animationFrame = window.requestAnimationFrame(draw);
      };
      const stopAnimation = () => {
        if (animationFrame) window.cancelAnimationFrame(animationFrame);
        animationFrame = 0;
      };

      resizeCanvas();
      startAnimation();
      try {
        const resizeObserver = new ResizeObserver(resizeCanvas);
        resizeObserver.observe(portfolio);
      } catch {
        window.addEventListener('resize', resizeCanvas, { passive: true });
      }
      document.addEventListener('visibilitychange', () => {
        pageVisible = document.visibilityState !== 'hidden';
        if (pageVisible) startAnimation();
        else stopAnimation();
      });
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(([entry]) => {
          inView = Boolean(entry?.isIntersecting);
          if (inView) startAnimation();
          else stopAnimation();
        }, { threshold: 0.01 });
        observer.observe(portfolio);
      }
      prefersReducedMotion.addEventListener?.('change', (event) => {
        if (event.matches) stopAnimation();
        else startAnimation();
      });
    }
  }
</script>
