  .dp-panels { min-height: 360px; }
  .dp-panel { animation: dp-panel-in 280ms ease both; }
  .dp-panel-heading { margin: 0 0 22px; }
  .dp-section-index { margin-bottom: 8px; font-size: 0.62rem; }
  .dp-panel-heading h2 { margin: 0; color: var(--dp-ink); font-size: clamp(1.55rem, 3vw, 2rem); font-weight: 820; letter-spacing: -0.04em; line-height: 1.2; }
