---
import Icon from '../components/Icon.astro';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getPageContext } from '../lib/data';
import '../styles/galeri.css';
const { site: G, sections: sectionConfig, content: pageContent } = await getPageContext('/galeri', Astro.request);
const sectionEntry = (key) => sectionConfig.find((item) => item.section_key === key);
const sectionVisible = (key) => sectionEntry(key)?.enabled !== false;
const sectionOrder = (key, fallback) => sectionEntry(key)?.sort_order ?? fallback;

const cmsGalleryEyebrow = pageContent.eyebrow || "Momen Bersama";
const cmsGalleryHeadline = pageContent.headline || "Galeri Kelas";
const cmsGalleryIntro = pageContent.intro || "Kenangan dan momen berharga bersama keluarga besar TKJ XII-9. Klik foto untuk memperbesar.";
const cmsFeaturedEyebrow = pageContent.featuredEyebrow || "Sorotan";
const cmsFeaturedTitle = pageContent.featuredTitle || "Foto Pilihan";
const cmsCollectionEyebrow = pageContent.collectionEyebrow || "Galeri";
const cmsCollectionTitle = pageContent.collectionTitle || "Koleksi Foto Kelas";
const cmsGalleryFooterNote = pageContent.footerNote || "Foto diperbarui oleh admin kelas · Hubungi ketua untuk menambah foto";
const galeri = G.galeri || [];
const carouselData = galeri.slice(0, 5);

---

<Layout
  title="Galeri & Kenangan Kelas XII-9 TKJ — SMK Muhammadiyah Belitang"
  description="Dokumentasi dan momen berharga kebersamaan keluarga besar kelas TKJ XII-9 SMK Muhammadiyah Belitang."
>
  <Header />
  <main id="main-content" tabindex="-1" style="display:flex;flex-direction:column">
      <div class="sec-head" style="order:0">
        <div class="sec-tag">{cmsGalleryEyebrow}</div>
        <h1 class="sec-title">{cmsGalleryHeadline}</h1>
        <p class="deskripsi-seksi">
          {cmsGalleryIntro}
        </p>
      </div>

      {carouselData.length > 0 && sectionVisible("featured") && (
        <section class="carousel-3d-wrapper reveal" aria-label="Sorotan Galeri" style={`order:${sectionOrder("featured",1)}`}>
          <div class="sec-tag" style="text-align: center;">{cmsFeaturedEyebrow}</div>
          <h2 class="sec-subtitle" style="text-align: center; margin-bottom: 2rem;">{cmsFeaturedTitle}</h2>
          <div class="carousel-3d" id="carousel-3d" aria-label="Foto pilihan kelas">
            {carouselData.map((item, idx) => (
              <div id={`carousel-slide-${idx}`} class={`carousel-item ${idx === 0 ? 'active' : ''}`} data-index={idx} role="button" tabindex={idx === 0 ? 0 : -1} aria-label={`Slide ${idx + 1} dari ${carouselData.length}`}>
                <img
                  src={item.src}
                  alt={item.alt_text || item.caption || "Foto pilihan kelas"}
                  loading={idx === 0 ? "eager" : "lazy"}
                  fetchpriority={idx === 0 ? "high" : "auto"}
                  decoding="async"
                />
              </div>
            ))}
          </div>
          <div class="carousel-3d-controls">
            <button class="carousel-3d-prev" id="carousel-3d-prev" aria-label="Foto Sebelumnya" type="button">
              <Icon name="fa-chevron-left" />
            </button>
            <div class="carousel-3d-dots" id="carousel-3d-dots" role="group" aria-label="Pilih foto sorotan">
              {carouselData.map((_, idx) => (
                <button type="button" class={`carousel-dot ${idx === 0 ? 'active' : ''}`} data-index={idx} aria-controls={`carousel-slide-${idx}`} aria-label={`Pergi ke slide ${idx + 1}`} aria-pressed={idx === 0 ? 'true' : 'false'}></button>
              ))}
            </div>
            <button class="carousel-3d-next" id="carousel-3d-next" aria-label="Foto Berikutnya" type="button">
              <Icon name="fa-chevron-right" />
            </button>
            <button class="carousel-autoplay-toggle" id="carousel-autoplay-toggle" type="button" aria-pressed="false" aria-label="Jeda pergantian foto otomatis">Jeda otomatis</button>
          </div>
        </section>
      )}

      {sectionVisible("grid") && (
      <section class="gallery-section reveal" style={`margin-top:4rem;order:${sectionOrder("grid",2)}`}>
        <div class="sec-tag">{cmsCollectionEyebrow}</div>
        <h2 class="sec-subtitle">{cmsCollectionTitle}</h2>
        {galeri.length > 0 ? (
        <>
        <div class="grid-galeri" id="grid-galeri" aria-label="Galeri foto kelas TKJ XII-9">
          {galeri.slice(0, 8).map((item, idx) => (
            <div class="item-galeri reveal" style={`--d: ${(idx % 5) * 0.05}s`} tabindex="0" role="button" aria-label={`Perbesar foto ${idx + 1}${item.caption ? `: ${item.caption}` : ""}`}>
              <img src={item.src} alt={item.alt_text || item.caption || "Galeri foto"} loading="lazy" decoding="async" />
              {item.caption && (
                <div class="keterangan-galeri">
                  <span>{item.caption}</span>
                </div>
              )}
            </div>
          ))}
        </div>
        {galeri.length > 8 && (
          <>
            <template id="gallery-more-template">
              {galeri.slice(8).map((item, idx) => (
                <div class="item-galeri reveal" style={`--d: ${(idx % 5) * 0.05}s`} tabindex="0" role="button" aria-label={`Perbesar foto ${idx + 9}${item.caption ? `: ${item.caption}` : ""}`}>
                  <img src={item.src} alt={item.alt_text || item.caption || "Galeri foto"} loading="lazy" decoding="async" />
                  {item.caption && <div class="keterangan-galeri"><span>{item.caption}</span></div>}
                </div>
              ))}
            </template>
            <div class="gallery-load-more-wrap">
              <button id="load-more-gallery" class="gallery-load-more" type="button">Muat 8 foto lagi</button>
              <p id="gallery-load-more-status" class="gallery-load-more-status" role="status" aria-live="polite"></p>
            </div>
          </>
        )}
        </>
        ) : (
          <p class="gallery-empty-state" role="status">Belum ada foto yang ditambahkan ke galeri.</p>
        )}
      </section>
      )}

      <p class="catatan-galeri" style="margin-top:2rem;order:99">
        <Icon name="fa-camera" />
        {cmsGalleryFooterNote}
      </p>

      <!-- Lightbox Galeri -->
      <div id="jendela-gambar" class="jendela-gambar" role="dialog" aria-modal="true" aria-hidden="true" inert aria-label="Pratinjau foto galeri">
        <button id="tutup-jendela" class="tutup-jendela" type="button" aria-label="Tutup pratinjau"><Icon name="fa-times" /></button>
        <button id="lb-prev" class="navigasi-jendela lb-prev" type="button" aria-label="Foto sebelumnya" hidden><Icon name="fa-chevron-left" /></button>
        <div class="konten-jendela">
          <img id="lightbox-img" alt="Pratinjau foto" />
          <div id="lb-caption-bar" class="bilah-keterangan-jendela"></div>
        </div>
        <button id="lb-next" class="navigasi-jendela lb-next" type="button" aria-label="Foto berikutnya" hidden><Icon name="fa-chevron-right" /></button>
      </div>
  </main>
  <Footer />

  <script>
    import '../scripts/galeri.js';
  </script>
</Layout>
