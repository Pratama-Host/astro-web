---
import Icon from '../components/Icon.astro';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Intro from '../components/Intro.astro';
import Footer from '../components/Footer.astro';
import { getPageContext } from '../lib/data';
import '../styles/beranda.css';
const { site: G, sections: sectionConfig, content: pageContent } = await getPageContext('/', Astro.request);
const cmsTeachersEyebrow = pageContent.teachersEyebrow || "Tim Pengajar";
const cmsTeachersTitle = pageContent.teachersTitle || "Arsitek Kompetensi Kami";
const sectionVisible = (key) => sectionConfig.find((item) => item.section_key === key)?.enabled !== false;
const sectionOrder = (key, fallback) => sectionConfig.find((item) => item.section_key === key)?.sort_order ?? fallback;
const hero = G.hero || {};

// Utility functions for pre-rendering
function makeInitials(name = "") {
  return name.split(" ").slice(0, 2).map(w => w[0]?.toUpperCase() || "").join("");
}

const stats = G.stats || [];
const guru = G.guru || [];
const visi = typeof G.visi === "string" ? G.visi.trim() : "";
const misi = Array.isArray(G.misi) ? G.misi.filter((item) => typeof item === "string" && item.trim()) : [];
const prestasi = Array.isArray(G.prestasi) ? G.prestasi.filter((item) => item?.judul) : [];
const motto = typeof G.motto === "string" ? G.motto.trim() : "";
const hasAbout = Boolean(visi || misi.length || prestasi.length || motto);

---

<Layout title={`${G.namaKelas || "TKJ XII-9"} - Beranda | ${G.namaSekolah || "SMK Muhammadiyah Belitang"}`}>
  <Intro />
  <Header />

  <main id="main-content" tabindex="-1" style="display:flex;flex-direction:column">
    {sectionVisible("hero") && (
    <section class="hero" aria-label="Selamat datang di TKJ XII-9" style={`order:${sectionOrder("hero",0)}`}>
      <div class="hero-noise" aria-hidden="true"></div>
      <div class="hero-floats" aria-hidden="true">
        <div class="float-icon fi1"><Icon name="fa-network-wired" /></div>
        <div class="float-icon fi2"><Icon name="fa-code" /></div>
        <div class="float-icon fi3"><Icon name="fa-shield-halved" /></div>
        <div class="float-icon fi4"><Icon name="fa-microchip" /></div>
        <div class="float-icon fi5"><Icon name="fa-terminal" /></div>
        <div class="float-icon fi6"><Icon name="fa-server" /></div>
      </div>
      <div class="hero-content">
        <div class="hero-eyebrow">{hero.eyebrow || "Teknik Komputer & Jaringan"}</div>
        <h1 class="hero-title">
          {hero.schoolPrefix || 'SMK'} <span class="hl glitch-text" data-text={hero.highlight || 'MUBELA'}>{hero.highlight || 'MUBELA'}</span><br />{hero.classLabel || `${G.namaKelas || 'XII-9'} TKJ.`}
        </h1>
        <p
          class="hero-desc"
          id="slogan-pahlawan"
          aria-live="polite"
        >
          {G.sloganHero}
        </p>
        <div class="hero-cta">
          <a href={hero.primaryHref || "/pengembang"} class="tombol tombol-utama"
            >{hero.primaryText || "Kenali Kami"} <Icon name="fa-arrow-right" /></a>
          <a href={hero.secondaryHref || "/anggota"} class="tombol tombol-garis">{hero.secondaryText || "Lihat Anggota"}</a>
        </div>
      </div>
    </section>
    )}

    <!-- Stats Strip -->
    {sectionVisible("stats") && (
    <section class="stats-section reveal" aria-label="Statistik kelas" style={`order:${sectionOrder("stats",1)}`}>
      <div class="wadah">
        <div id="strip-statistik" class="strip-statistik">
          {stats.map((s) => (
            <div class="stat-cell reveal">
              <div class="stat-num" data-target={s.angka} data-suffix={s.suffix || ""}>
                0{s.suffix || ""}
              </div>
              <div class="stat-lbl">{s.label}</div>
            </div>
          ))}
        </div>
      </div>
    </section>
    )}

    <!-- Guru Section -->
    {sectionVisible("teachers") && (
    <section id="guru-section" class="wadah reveal" aria-label="Tim Pengajar TKJ XII-9" style={`order:${sectionOrder("teachers",2)}`}>
      <div class="sec-header">
        <div class="sec-tag">{cmsTeachersEyebrow}</div>
        <h2 class="sec-title">{cmsTeachersTitle}</h2>
      </div>
      <div class="grid-guru">
        {guru.map((g, i) => (
          <div class="card guru-card card-accent-top reveal" style={`--d: ${i * 0.08}s`}>
            <div class="avatar lg avatar-ring" style="margin:0 auto 14px">
              {g.foto ? (
                <img src={g.foto} alt={g.nama} loading="lazy" />
              ) : (
                <span>{makeInitials(g.nama)}</span>
              )}
            </div>
            <div style="text-align:center;margin-bottom:8px">
              <div style="font-weight:700;font-size:var(--text-md);color:var(--text-1)">{g.nama}</div>
              <span class="chip" style="margin-top:4px">{g.mapel}</span>
            </div>
            <div class="guru-role">{g.peran}</div>
            <blockquote class="guru-quote">{g.quote}</blockquote>
            <div class="guru-power-label">// POWER LEVEL</div>
            <div class="guru-bars">
              {(g.expertise || []).map((e) => (
                <div class="guru-bar-item">
                  <div class="guru-bar-meta">
                    <span>{e.label}</span>
                    <span>{e.level}%</span>
                  </div>
                  <div class="bar-bg">
                    <div class="bar-fill" data-level={e.level} style="width: 0%"></div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>
    )}
    <!-- Visi, Misi & Prestasi -->
    {sectionVisible("about") && hasAbout && (
    <section id="tentang-kelas" class="wadah reveal" aria-label="Visi, misi, dan prestasi kelas" style={`order:${sectionOrder("about",3)}`}>
      <div class="sec-header">
        <div class="sec-tag">Tentang Kelas</div>
        <h2 class="sec-title">Visi, Misi & Prestasi</h2>
        {motto && <p class="about-motto">“{motto}”</p>}
      </div>
      <div class="about-grid">
        {(visi || misi.length > 0) && (
          <div class="card card-accent-top about-card reveal">
            {visi && (<><h3 class="about-label">Visi</h3><p class="about-text">{visi}</p></>)}
            {misi.length > 0 && (<><h3 class="about-label">Misi</h3><ul class="about-list">{misi.map((item) => <li>{item}</li>)}</ul></>)}
          </div>
        )}
        {prestasi.length > 0 && (
          <div class="card card-accent-top about-card reveal">
            <h3 class="about-label">Prestasi</h3>
            <ul class="about-list about-prestasi">
              {prestasi.map((item) => (
                <li>
                  <span class="about-prestasi-title">{item.judul}</span>
                  <span class="about-prestasi-meta">{[item.tingkat, item.tahun].filter(Boolean).join(" · ")}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </section>
    )}

  </main>

  <Footer />

  <script>
    import '../scripts/beranda.js';
  </script>
</Layout>
