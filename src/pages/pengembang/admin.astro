---
const pageTitle = 'CMS Admin — TKJ XII-9';
import '../../styles/admin.css';
---
<!doctype html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex,nofollow" />
  <meta name="theme-color" content="#111018" />
  <title>{pageTitle}</title>

</head>
<body>
  <a class="admin-skip-link" href="#login-screen">Lewati ke konten utama</a>
  <main id="login-screen" class="login-wrap" aria-label="Login administrator">
    <div class="login-card">
      <div class="brand-mark">XII9</div>
      <p class="eyebrow">TKJ XII-9 · Content Management</p>
      <h1>Masuk ke CMS</h1>
      <p class="muted">Kelola konten, anggota, galeri, media, dan pengaturan website dari satu tempat.</p>
      <form id="login-form" class="grid" style="gap:12px;margin-top:22px">
        <div class="field"><label for="admin-password">Password admin</label><input id="admin-password" type="password" autocomplete="current-password" required /></div>
        <button class="btn" id="login-button" type="submit">Masuk ke dashboard</button>
        <p id="login-status" class="status" role="status"></p>
      </form>
      <a class="muted small" href="/pengembang" style="display:inline-block;margin-top:16px">← Kembali ke website</a>
    </div>
  </main>

  <div id="admin-shell" class="shell hidden">
    <aside id="sidebar" class="sidebar" aria-label="Navigasi CMS">
      <div class="brand"><div class="brand-mark">XII9</div><div><strong>TKJ XII-9 CMS</strong><small>Website Control Center</small></div></div>
      <nav class="admin-navigation" aria-label="Navigasi dashboard">
      <div class="nav-group">Ringkasan</div>
      <button type="button" class="nav-btn active" data-view="dashboard"><span class="ic">▦</span> Dashboard</button>
      <div class="nav-group">Konten website</div>
      <button type="button" class="nav-btn" data-view="members"><span class="ic">♙</span> Anggota</button>
      <button type="button" class="nav-btn" data-view="gallery"><span class="ic">▧</span> Galeri</button>
      <button type="button" class="nav-btn" data-view="announcements"><span class="ic">◷</span> Pengumuman & agenda</button>
      <button type="button" class="nav-btn" data-view="content"><span class="ic">✎</span> Konten & profil</button>
      <button type="button" class="nav-btn" data-view="collections"><span class="ic">✦</span> Guru & keahlian</button>
      <button type="button" class="nav-btn" data-view="sections"><span class="ic">▤</span> Section halaman</button>
      <div class="nav-group">Pengaturan website</div>
      <button type="button" class="nav-btn" data-view="appearance"><span class="ic">◐</span> Tampilan & media</button>
      <button type="button" class="nav-btn" data-view="navigation"><span class="ic">☷</span> Navigasi</button>
      <button type="button" class="nav-btn" data-view="seo"><span class="ic">✎</span> Pengembang & SEO</button>
      <button type="button" class="nav-btn" data-view="media"><span class="ic">▣</span> Media library</button>
      <button type="button" class="nav-btn" data-view="system"><span class="ic">⚙</span> Sistem & backup</button>
      </nav>
      <div class="sidebar-bottom"><button type="button" id="logout-button" class="btn ghost" style="width:100%">Keluar dari admin</button><a href="/" class="muted small" style="display:block;margin:14px 4px 0">↗ Lihat website publik</a></div>
    </aside>

    <main id="admin-main" class="main" tabindex="-1">
      <div class="topbar">
        <div><button id="mobile-menu" class="btn ghost mobile-menu" type="button" aria-controls="sidebar" aria-expanded="false">☰ Menu</button><p class="eyebrow">Pusat pengelolaan website</p><h1 id="view-title" tabindex="-1" aria-live="polite" aria-atomic="true">Dashboard</h1><p id="view-subtitle">Ringkasan kondisi website TKJ XII-9.</p></div>
        <span id="connection-status" class="badge" role="status" aria-live="polite">Memeriksa Supabase…</span>
      </div>

      <section id="view-dashboard" class="view active">
        <div class="grid three" id="dashboard-stats">
          <div class="stats-card"><span>Anggota</span><strong>—</strong></div><div class="stats-card"><span>Galeri</span><strong>—</strong></div><div class="stats-card"><span>Media</span><strong>—</strong></div>
        </div>
        <div class="grid two" style="margin-top:14px">
          <div class="panel"><div class="panel-head"><div><h2>Aktivitas terbaru</h2><p class="muted small">Riwayat perubahan yang tercatat di CMS.</p></div><button type="button" class="btn ghost small-btn" data-go="media">Media library</button></div><div id="activity-list" class="item-list"><div class="empty">Memuat aktivitas…</div></div></div>
          <div class="panel"><h2>Pintasan pengelolaan</h2><p class="muted small">Buka modul yang ingin diperbarui.</p><div class="grid two" style="margin-top:14px"><button type="button" class="btn ghost" data-go="members">Kelola anggota</button><button type="button" class="btn ghost" data-go="gallery">Kelola galeri</button><button type="button" class="btn ghost" data-go="announcements">Pengumuman & agenda</button><button type="button" class="btn ghost" data-go="content">Edit konten</button><button type="button" class="btn ghost" data-go="appearance">Atur tampilan</button><button type="button" class="btn ghost" data-go="navigation">Atur navigasi</button><button type="button" class="btn ghost" data-go="seo">Pengaturan SEO</button></div><div class="notice" style="margin-top:16px">Status tersambung berarti endpoint admin berhasil membaca tabel CMS. Ukuran media dihitung dari metadata file yang tercatat, bukan kuota total bucket.</div><p id="dashboard-status" class="status" role="status" aria-live="polite" aria-atomic="true"></p></div>
        </div>
      </section>

      <section id="view-members" class="view">
        <div class="view-intro"><h2>Manajemen anggota</h2><p>Kelola identitas, jabatan, media profil, keterampilan, urutan, dan visibilitas anggota.</p></div>
        <div class="panel">
          <div class="panel-head"><div><h2 id="member-form-title">Tambah anggota</h2><p class="muted small">NIS menjadi identitas unik anggota.</p></div><span id="member-dirty" class="badge hidden">Belum disimpan</span></div>
          <form id="member-form" class="grid">
            <input type="hidden" id="original_nis" />
            <div class="grid two"><div class="field"><label for="member-nama">Nama lengkap *</label><input id="member-nama" maxlength="160" required /></div><div class="field"><label for="member-nis">NIS *</label><input id="member-nis" maxlength="40" required /></div><div class="field"><label for="member-kelas">Kelas</label><input id="member-kelas" value="XII-9" maxlength="40" /></div><div class="field"><label for="member-jabatan">Jabatan</label><input id="member-jabatan" maxlength="100" /></div><div class="field"><label for="member-foto">URL foto profil</label><input id="member-foto" type="url" /></div><div class="field"><label for="member-photo-file">Upload foto profil (opsional)</label><input id="member-photo-file" type="file" accept="image/*" /></div><div class="field"><label for="member-audio">URL audio profil</label><input id="member-audio" type="url" /></div><div class="field"><label for="member-audio-nama">Nama audio</label><input id="member-audio-nama" /></div><div class="field"><label for="member-foto-audio">URL foto audio</label><input id="member-foto-audio" type="url" /></div></div>
            <div class="field"><label for="member-desc">Deskripsi</label><textarea id="member-desc"></textarea></div>
            <div class="grid two"><div class="field"><label for="member-desc-audio">Deskripsi audio</label><textarea id="member-desc-audio"></textarea></div><div class="field"><label for="member-skills">Skill anggota (pisahkan dengan koma)</label><input id="member-skills" placeholder="Networking, Linux, Web Development" /></div></div>
            <div class="field"><label for="member-social">Media sosial (JSON object)</label><textarea id="member-social" placeholder='{"instagram":"https://..."}'></textarea></div>
            <div class="grid two"><div class="field"><label for="member-order">Urutan</label><input id="member-order" type="number" min="0" value="0" /></div><label class="checkline" style="align-self:end"><input id="member-visible" type="checkbox" checked /> Tampilkan di website publik</label></div>
            <div class="form-actions"><button class="btn" id="save-member" type="submit">Simpan anggota</button><button class="btn ghost" id="reset-member" type="button">Batal / anggota baru</button></div><p id="member-status" class="status" role="status" aria-live="polite" aria-atomic="true"></p>
          </form>
        </div>
        <div class="panel"><div class="panel-head"><div><h2>Daftar anggota</h2><p class="muted small" id="members-count">Memuat data…</p></div><div class="toolbar"><input id="member-search" class="control" placeholder="Cari nama, NIS, jabatan…" /><button type="button" class="btn ghost small-btn" id="refresh-members">Muat ulang</button></div></div><div class="table-wrap"><table><thead><tr><th>Nama</th><th>NIS</th><th>Kelas</th><th>Jabatan</th><th>Status</th><th>Aksi</th></tr></thead><tbody id="members-table"><tr><td colspan="6">Memuat data…</td></tr></tbody></table></div></div>
      </section>

      <section id="view-gallery" class="view">
        <div class="view-intro"><h2>Manajemen galeri</h2><p>Upload beberapa foto sekaligus, atur caption, judul, kategori, tanggal dokumentasi, visibilitas, dan urutan.</p></div>
        <div class="panel"><h2>Tambah foto galeri</h2><form id="gallery-upload-form" class="grid"><div class="grid two"><div class="field"><label for="gallery-files">Pilih foto (bisa beberapa)</label><input id="gallery-files" type="file" accept="image/*" multiple required /></div><div class="field"><label for="gallery-caption-default">Caption awal (opsional)</label><input id="gallery-caption-default" maxlength="240" placeholder="Kegiatan kelas..." /></div></div><button class="btn" id="gallery-upload-button" type="submit">Upload foto ke galeri</button><p id="gallery-upload-status" class="status" role="status" aria-live="polite" aria-atomic="true"></p></form></div>
        <div class="panel"><div class="panel-head"><div><h2>Semua foto</h2><p class="muted small" id="gallery-count">Memuat galeri…</p></div><button type="button" class="btn ghost small-btn" id="refresh-gallery">Muat ulang</button></div><div id="gallery-grid" class="media-grid"></div></div>
      </section>

      <section id="view-announcements" class="view">
        <div class="view-intro"><h2>Pengumuman & agenda kelas</h2><p>Buat informasi kelas, jadwalkan waktu terbit, dan kelola kegiatan. Konten berstatus draft atau arsip tidak tampil pada halaman publik.</p></div>
        <div class="panel">
          <div class="panel-head"><div><h2>Pilih jenis konten</h2><p class="muted small">Kedua jenis konten disimpan terpisah dan memiliki daftar masing-masing.</p></div></div>
          <div class="toolbar" role="group" aria-label="Jenis konten">
            <button type="button" class="btn" id="announcement-kind-news" aria-pressed="true">Pengumuman</button>
            <button type="button" class="btn ghost" id="announcement-kind-agenda" aria-pressed="false">Agenda kegiatan</button>
          </div>
        </div>
        <div class="panel">
          <div class="panel-head"><div><h2 id="announcement-form-title">Buat pengumuman</h2><p class="muted small">Simpan sebagai draft terlebih dahulu, lalu ubah status menjadi Terbit setelah siap.</p></div><span id="announcement-form-mode" class="badge">Item baru</span></div>
          <form id="announcement-form" class="grid">
            <input type="hidden" id="announcement-id" />
            <div class="grid two">
              <div class="field"><label for="announcement-title">Judul *</label><input id="announcement-title" maxlength="160" required /></div>
              <div class="field"><label for="announcement-category">Kategori</label><input id="announcement-category" maxlength="60" value="Kelas" /></div>
              <div class="field"><label for="announcement-status-select">Status</label><select id="announcement-status-select"><option value="draft">Draft</option><option value="published">Terbit</option><option value="archived">Arsip</option></select></div>
            </div>
            <div class="field"><label id="announcement-body-label" for="announcement-body">Isi pengumuman</label><textarea id="announcement-body" maxlength="5000" placeholder="Tuliskan informasi yang perlu diketahui kelas…"></textarea></div>
            <div id="announcement-only-fields" class="grid two">
              <div class="field"><label for="announcement-publish-at">Jadwalkan terbit (opsional)</label><input id="announcement-publish-at" type="datetime-local" /></div>
              <div class="field"><label for="announcement-expires-at">Sembunyikan setelah (opsional)</label><input id="announcement-expires-at" type="datetime-local" /></div>
              <div class="field"><label for="announcement-link-url">Tautan tambahan (opsional)</label><input id="announcement-link-url" type="url" placeholder="https://…" /></div>
              <label class="checkline" style="align-self:end"><input id="announcement-pinned" type="checkbox" /> Sematkan di bagian atas</label>
            </div>
            <div id="agenda-only-fields" class="grid two" hidden>
              <div class="field"><label for="agenda-starts-at">Waktu mulai *</label><input id="agenda-starts-at" type="datetime-local" required /></div>
              <div class="field"><label for="agenda-ends-at">Waktu selesai (opsional)</label><input id="agenda-ends-at" type="datetime-local" /></div>
              <div class="field"><label for="agenda-location">Lokasi (opsional)</label><input id="agenda-location" maxlength="160" placeholder="Ruang kelas, aula, laboratorium…" /></div>
            </div>
            <div class="form-actions"><button class="btn" id="announcement-save" type="submit">Simpan pengumuman</button><button class="btn ghost" id="announcement-reset" type="button">Batal / item baru</button><button class="btn ghost small-btn" id="announcement-refresh" type="button">Muat ulang daftar</button></div>
            <p id="announcement-status" class="status" role="status" aria-live="polite" aria-atomic="true"></p>
          </form>
        </div>
        <div class="panel">
          <div class="panel-head"><div><h2 id="announcement-list-title">Daftar pengumuman</h2><p class="muted small" id="announcement-count">Memuat data…</p></div></div>
          <div id="announcement-list" class="item-list"><div class="empty">Memuat konten…</div></div>
        </div>
      </section>

      <section id="view-content" class="view">
        <div class="view-intro"><h2>Konten & profil website</h2><p>Field di bawah bersumber dari konfigurasi aktual <code>G.json</code> dan `site_settings`. Konten tersimpan sebagai JSONB dan langsung digunakan halaman publik.</p></div>
        <form id="content-form" class="grid">
          <div class="panel"><h2>Identitas website dan kelas</h2><div class="grid two" style="margin-top:14px"><div class="field"><label for="c-namaKelas">Nama kelas</label><input id="c-namaKelas" /></div><div class="field"><label for="c-jurusan">Jurusan</label><input id="c-jurusan" /></div><div class="field"><label for="c-namaSekolah">Nama sekolah</label><input id="c-namaSekolah" /></div><div class="field"><label for="c-tahunAjaran">Tahun ajaran</label><input id="c-tahunAjaran" /></div><div class="field"><label for="c-motto">Motto</label><input id="c-motto" /></div></div><div class="field" style="margin-top:12px"><label for="c-deskripsi">Deskripsi kelas</label><textarea id="c-deskripsi"></textarea></div></div>
          <div class="panel"><h2>Hero beranda</h2><div class="grid two" style="margin-top:14px"><div class="field"><label for="c-hero-eyebrow">Label kecil hero</label><input id="c-hero-eyebrow" /></div><div class="field"><label for="c-hero-school">Teks sebelum highlight</label><input id="c-hero-school" /></div><div class="field"><label for="c-hero-highlight">Teks highlight</label><input id="c-hero-highlight" /></div><div class="field"><label for="c-hero-class">Teks kelas</label><input id="c-hero-class" /></div><div class="field"><label for="c-hero-primary">Tombol utama</label><input id="c-hero-primary" /></div><div class="field"><label for="c-hero-primary-href">Link tombol utama</label><input id="c-hero-primary-href" /></div><div class="field"><label for="c-hero-secondary">Tombol kedua</label><input id="c-hero-secondary" /></div><div class="field"><label for="c-hero-secondary-href">Link tombol kedua</label><input id="c-hero-secondary-href" /></div></div><div class="field" style="margin-top:12px"><label for="c-sloganHero">Subjudul / slogan hero</label><textarea id="c-sloganHero"></textarea></div></div>
          <div class="panel"><h2>Visi, misi, dan wali kelas</h2><div class="field" style="margin-top:14px"><label for="c-visi">Visi</label><textarea id="c-visi"></textarea></div><div class="field"><label for="c-misi">Misi (satu item per baris)</label><textarea id="c-misi"></textarea></div><div class="grid two"><div class="field"><label for="c-wali-nama">Nama wali kelas</label><input id="c-wali-nama" /></div><div class="field"><label for="c-wali-jabatan">Jabatan wali kelas</label><input id="c-wali-jabatan" /></div><div class="field"><label for="c-wali-foto">Foto wali kelas</label><input id="c-wali-foto" type="url" /></div><div class="field"><label for="c-wali-desc">Deskripsi wali kelas</label><input id="c-wali-desc" /></div></div></div>
          <div class="panel"><h2>Konten beranda dan halaman TKJ</h2><p class="muted small">Bagian daftar menggunakan JSON terstruktur. Pertahankan nama properti yang ditampilkan contoh ketika mengubahnya.</p><div class="grid two" style="margin-top:14px"><div class="field"><label for="c-stats">Statistik beranda (JSON array)</label><textarea id="c-stats" class="json-editor" spellcheck="false"></textarea></div><div class="field"><label for="c-prestasi">Prestasi (JSON array)</label><textarea id="c-prestasi" class="json-editor" spellcheck="false"></textarea></div><div class="field"><label for="c-tkj">Data halaman TKJ (JSON object)</label><textarea id="c-tkj" class="json-editor" spellcheck="false"></textarea></div></div><div class="field" style="margin-top:12px"><label for="c-social">Media sosial (JSON object)</label><textarea id="c-social" class="json-editor" spellcheck="false"></textarea></div><div class="field" style="margin-top:12px"><label for="c-footer">Tautan footer (JSON object dengan links[])</label><textarea id="c-footer" class="json-editor" spellcheck="false"></textarea></div></div>
          <div class="form-actions"><button class="btn" id="save-content" type="submit">Simpan seluruh konten</button><button class="btn ghost" id="reload-content" type="button">Muat ulang dari Supabase</button><span id="content-dirty" class="badge hidden">Ada perubahan belum disimpan</span></div><p id="content-status" class="status" role="status" aria-live="polite" aria-atomic="true"></p>
        </form>
      </section>

      <section id="view-collections" class="view">
        <div class="view-intro"><h2>Guru dan keahlian</h2><p>Kedua data ini memakai tabel `guru` dan `skills` yang sudah ada. Editor JSON menjaga seluruh properti aktual tanpa mengganti struktur tabel.</p></div>
        <div class="panel"><div class="panel-head"><div><h2>Data guru</h2><p class="muted small">nama, mapel, peran, quote, expertise[]</p></div><button type="button" class="btn ghost small-btn" id="reload-guru">Muat ulang</button></div><div class="field"><label for="guru-json">Daftar guru (JSON array)</label><textarea id="guru-json" class="json-editor" style="min-height:260px" spellcheck="false"></textarea></div><div class="form-actions"><button type="submit" class="btn" id="save-guru">Simpan data guru</button></div><p id="guru-status" class="status" role="status" aria-live="polite" aria-atomic="true"></p></div>
        <div class="panel"><div class="panel-head"><div><h2>Data keahlian</h2><p class="muted small">nama, level (0–100), icon, deskripsi</p></div><button type="button" class="btn ghost small-btn" id="reload-skills">Muat ulang</button></div><div class="field"><label for="skills-json">Daftar keahlian (JSON array)</label><textarea id="skills-json" class="json-editor" style="min-height:260px" spellcheck="false"></textarea></div><div class="form-actions"><button type="submit" class="btn" id="save-skills">Simpan data keahlian</button></div><p id="skills-status" class="status" role="status" aria-live="polite" aria-atomic="true"></p></div>
      </section>

      <section id="view-appearance" class="view">
        <div class="view-intro"><h2>Tampilan global dan Theme Studio pengembang</h2><p>Atur aset website kelas secara terpisah dari tema warna khusus halaman <code>/pengembang</code>. Media upload tetap menggunakan bucket <code>astro</code>.</p></div>
        <form id="appearance-form" class="grid">
          <div class="panel"><h2>Aset website</h2><div class="grid two" style="margin-top:14px"><div class="field"><label for="a-logo">Logo utama URL</label><input id="a-logo" type="url"/><img id="preview-logo" class="preview-img hidden" alt="Preview logo"/></div><div class="field"><label for="a-logo-alt">Logo alternatif URL</label><input id="a-logo-alt" type="url"/><img id="preview-logo-alt" class="preview-img hidden" alt="Preview logo alternatif"/></div><div class="field"><label for="a-favicon">Favicon URL</label><input id="a-favicon" type="url"/><img id="preview-favicon" class="preview-img hidden" alt="Preview favicon"/></div><div class="field"><label for="a-background">Background image URL</label><input id="a-background" type="url"/><img id="preview-background" class="preview-img hidden" alt="Preview background"/></div><div class="field"><label for="a-og">Open Graph image URL</label><input id="a-og" type="url"/><img id="preview-og" class="preview-img hidden" alt="Preview OG"/></div><div class="field"><label for="a-audio">Audio latar URL</label><input id="a-audio" type="url"/></div></div></div>
          <div class="panel"><h2>Tema dan warna</h2><div class="grid three" style="margin-top:14px"><div class="field"><label for="a-theme">Tema default</label><select id="a-theme"><option value="dark">Dark</option><option value="light">Light</option><option value="blue">Blue</option></select></div><div class="field"><label for="a-accent">Warna aksen</label><input id="a-accent" type="color" value="#dc2626"/></div><div class="field"><label for="a-background-color">Warna latar</label><input id="a-background-color" type="color" value="#0a0505"/></div><div class="field"><label for="a-audio-volume">Volume default audio (0–100%)</label><input id="a-audio-volume" type="number" min="0" max="100" value="80"/></div></div><div class="notice" style="margin-top:14px">Warna yang diedit hanya berlaku untuk tema yang dipilih. Dark, Light, dan Blue menyimpan palet masing-masing.</div></div>
          <div class="form-actions"><button class="btn" type="submit" id="save-appearance">Simpan tampilan</button></div><p id="appearance-status" class="status" role="status" aria-live="polite" aria-atomic="true"></p>
        </form>
        <section class="panel developer-theme-studio" aria-labelledby="developer-theme-title">
          <div class="panel-head"><div><h2 id="developer-theme-title">Theme Studio · Halaman Pengembang</h2><p class="muted small">Warna ini hanya berlaku untuk /pengembang. Simpan sebagai draft, periksa preview, lalu publikasikan setelah workflow database siap.</p></div><span class="badge">Developer only</span></div>
          <div class="grid two">
            <div class="field"><label for="developer-theme-preset">Preset tema</label><select id="developer-theme-preset"><option value="brutalist-yellow">Brutalist Yellow</option><option value="monochrome">Monochrome</option><option value="electric-pop">Electric Pop</option><option value="custom">Custom</option></select></div>
            <div class="field"><label>Preview langsung</label><div id="developer-theme-preview" class="developer-theme-preview" aria-live="polite"><strong>ALFREDO PRATAMA</strong><span>PLAYFUL NEO-BRUTALIST</span><button type="button" tabindex="-1">BAM! ↗</button></div></div>
          </div>
          <div class="grid three developer-theme-colors">
            <div class="field"><label for="developer-theme-frame">Canvas luar</label><input id="developer-theme-frame" type="color" value="#0A0A0A"/></div>
            <div class="field"><label for="developer-theme-background">Background halaman</label><input id="developer-theme-background" type="color" value="#F4F1E8"/></div>
            <div class="field"><label for="developer-theme-surface">Surface</label><input id="developer-theme-surface" type="color" value="#FFFDF8"/></div>
            <div class="field"><label for="developer-theme-text">Teks utama</label><input id="developer-theme-text" type="color" value="#111111"/></div>
            <div class="field"><label for="developer-theme-muted">Teks sekunder</label><input id="developer-theme-muted" type="color" value="#686868"/></div>
            <div class="field"><label for="developer-theme-border">Border</label><input id="developer-theme-border" type="color" value="#111111"/></div>
            <div class="field"><label for="developer-theme-primary">Primary accent</label><input id="developer-theme-primary" type="color" value="#F5CD32"/></div>
            <div class="field"><label for="developer-theme-secondary">Secondary accent</label><input id="developer-theme-secondary" type="color" value="#32CFC2"/></div>
            <div class="field"><label for="developer-theme-highlight">Highlight / CTA</label><input id="developer-theme-highlight" type="color" value="#D90B46"/></div>
          </div>
          <p id="developer-theme-contrast" class="status" role="status"></p>
          <div class="notice">Theme Studio mengatur canvas luar dan seluruh warna halaman pengembang. Kontras teks diperiksa sebelum disimpan. Pengaturan ini tidak mengubah tema global website kelas.</div>
          <div class="form-actions"><button class="btn" type="button" id="save-developer-theme">Simpan tema sebagai draft</button><button class="btn ghost" type="button" id="preview-developer-theme">Buka preview halaman</button><button class="btn ghost" type="button" id="publish-developer-theme">Publikasikan tema</button><button class="btn ghost" type="button" id="reset-developer-theme">Kembalikan preset awal</button></div>
          <p id="developer-theme-status" class="status" role="status"></p>
        </section>
        <div class="panel"><h2>Upload aset global</h2><form id="global-upload-form" class="grid"><div class="grid two"><div class="field"><label for="global-kind">Jenis aset</label><select id="global-kind"><option value="logo">Logo utama</option><option value="alternate_logo">Logo alternatif</option><option value="favicon">Favicon</option><option value="background">Background</option><option value="og">Open Graph image</option><option value="audio">Audio latar</option></select></div><div class="field"><label for="global-file">Pilih file</label><input id="global-file" type="file" required /></div></div><button type="submit" class="btn" id="global-upload-button">Upload dan terapkan</button><p id="global-upload-status" class="status" role="status" aria-live="polite" aria-atomic="true"></p></form></div>
      </section>

      <section id="view-navigation" class="view">
        <div class="view-intro"><h2>Manajemen navigasi</h2><p>Menu mengikuti halaman yang sudah tersedia. Tautan eksternal, API admin, dan halaman admin tidak dapat dimasukkan.</p></div>
        <div class="panel"><div class="panel-head"><div><h2>Daftar menu</h2><p class="muted small">Ubah label, tujuan, ikon, status, dan urutan dengan tombol naik/turun. Nama ikon lama fa-* tetap didukung melalui pemetaan lokal.</p></div><button type="button" class="btn ghost small-btn" id="add-navigation">+ Tambah menu</button></div><div id="navigation-list" class="item-list"></div><div class="form-actions"><button type="submit" class="btn" id="save-navigation">Simpan navigasi</button><button type="button" class="btn ghost" id="reload-navigation">Muat ulang</button></div><p id="navigation-status" class="status" role="status" aria-live="polite" aria-atomic="true"></p></div>
      </section>

      <section id="view-seo" class="view">
        <div class="view-intro"><h2>Konten Pengembang & SEO</h2><p>Editor cerita mengelola enam naskah lama tanpa menghapus substansinya. Konten lainnya tetap tersedia melalui editor JSON, dengan draft, pratinjau privat, dan publikasi terpisah.</p></div>
        <section class="panel developer-story-editor" aria-labelledby="developer-story-editor-title">
          <div class="panel-head"><div><h2 id="developer-story-editor-title">Editor cerita pengembang</h2><p class="muted small">Edit bab lama tanpa membuka file Astro. Format naskah: baris biasa untuk paragraf, <code>## Judul subbab</code> untuk heading, dan <code>- item</code> untuk daftar.</p></div><span class="badge">/pengembang</span></div>
          <div class="grid two">
            <div class="field"><label for="developer-story-select">Pilih bab</label><select id="developer-story-select"></select></div>
            <div class="form-actions" style="align-self:end;margin:0"><button class="btn ghost small-btn" type="button" id="developer-story-add">+ Tambah bab</button><button class="btn danger small-btn" type="button" id="developer-story-remove">Hapus bab</button></div>
          </div>
          <div class="field"><label for="developer-story-title">Judul bab</label><input id="developer-story-title" maxlength="180"/></div>
          <div class="field"><label for="developer-story-subtitle">Pengantar bab</label><input id="developer-story-subtitle" maxlength="500"/></div>
          <div class="field"><label for="developer-story-body">Isi dan subbab</label><textarea id="developer-story-body" class="json-editor" style="min-height:300px" spellcheck="true" placeholder="Paragraf pertama…

## Subbab
Paragraf berikutnya…

- Poin pertama"></textarea></div>
          <div class="grid two"><div class="field"><label for="developer-story-code-title">Judul blok kode (opsional)</label><input id="developer-story-code-title" maxlength="160"/></div><div class="field"><label for="developer-story-code-language">Bahasa kode</label><input id="developer-story-code-language" maxlength="40" value="JavaScript"/></div></div>
          <div class="field"><label for="developer-story-code">Contoh kode (opsional)</label><textarea id="developer-story-code" class="json-editor" style="min-height:180px" spellcheck="false"></textarea></div>
          <div class="field"><label for="developer-story-quote">Kutipan penutup (opsional)</label><textarea id="developer-story-quote" maxlength="1200"></textarea></div>
          <div class="form-actions"><button class="btn" type="button" id="save-developer-story">Simpan bab sebagai draft</button><button class="btn ghost" type="button" id="preview-developer-story">Preview halaman</button></div>
          <p id="developer-story-status" class="status" role="status"></p>
        </section>
        <div class="panel"><form id="seo-form" class="grid"><div class="field"><label for="seo-page">Halaman</label><select id="seo-page"><option value="/">Beranda (/)</option><option value="/anggota">Anggota</option><option value="/galeri">Galeri</option><option value="/struktur">Struktur</option><option value="/keahlian">Keahlian</option><option value="/tkj">TKJ</option><option value="/pengembang">Pengembang</option></select></div><div class="field"><label for="seo-title">Meta title</label><input id="seo-title" maxlength="180"/></div><div class="field"><label for="seo-description">Meta description</label><textarea id="seo-description" maxlength="320"></textarea></div><div class="field"><label for="seo-og">Open Graph image URL</label><input id="seo-og" type="url"/></div><div class="field"><label for="seo-content">Konten halaman (JSON object)</label><textarea id="seo-content" class="json-editor" style="min-height:180px" spellcheck="false" placeholder='{"headline":"Judul halaman","intro":"Deskripsi pembuka"}'></textarea><small class="muted">Kunci umum: eyebrow, headline, intro, featuredEyebrow, featuredTitle, collectionEyebrow, collectionTitle, footerNote, subjectsTitle, curriculumTitle, careersTitle, teachersEyebrow, teachersTitle, devIntroText, role, taglines[], experiences[], quote. Khusus /pengembang, gunakan developer.profile, typing[], focusCards[], hardSkills[], softSkills[], projects[], motivation[], journey[], principles[], quotes[], education[], notes[], dan contacts[]. Struktur lengkap ada di docs/CMS-IMPLEMENTATION.md.</small></div><label class="checkline"><input id="seo-noindex" type="checkbox"/> Jangan indeks halaman ini (noindex)</label><div class="notice">Perubahan halaman disimpan sebagai draft terlebih dahulu. Gunakan pratinjau untuk melihat halaman dengan sesi admin, lalu publikasikan setelah diperiksa.</div><div class="form-actions"><button class="btn" type="submit" id="save-page-draft">Simpan draft</button><button class="btn" type="button" id="publish-page-draft">Publikasikan draft</button><button class="btn ghost" type="button" id="preview-page-draft">Pratinjau draft</button><button class="btn danger" type="button" id="discard-page-draft">Buang draft</button><button class="btn ghost" type="button" id="reload-seo">Muat ulang</button></div><p id="seo-status" class="status" role="status" aria-live="polite" aria-atomic="true"></p></form></div><div class="panel"><h2>Ringkasan metadata</h2><div id="seo-list" class="item-list"></div></div>
      </section>

      <section id="view-sections" class="view">
        <div class="view-intro"><h2>Pengelola section halaman</h2><p>Status tampil/sembunyi dan urutan berlaku per section. Beranda memiliki kontrol Hero, Statistik, Tim Pengajar, dan Visi/Misi/Prestasi. Halaman Pengembang memiliki kontrol terpisah untuk profil, keahlian, karya, motivasi/perjalanan, kontak, cerita, filosofi, pengalaman, kutipan, edukasi, dan catatan.</p></div>
        <div class="panel"><div id="sections-list" class="item-list"><div class="empty">Memuat section…</div></div><div class="form-actions"><button type="submit" class="btn" id="save-sections">Simpan pengaturan section</button><button type="button" class="btn ghost" id="reload-sections">Muat ulang</button></div><p id="sections-status" class="status" role="status" aria-live="polite" aria-atomic="true"></p></div>
      </section>

      <section id="view-media" class="view">
        <div class="view-intro"><h2>Media library</h2><p>Seluruh upload tercatat dengan nama file, tipe, ukuran, kategori, dan URL publik. Penghapusan ditolak jika file masih direferensikan.</p></div>
        <div class="panel"><form id="media-upload-form" class="grid"><div class="grid two"><div class="field"><label for="media-category">Kategori</label><select id="media-category"><option value="assets">Aset umum</option><option value="icons">Ikon</option><option value="background">Background</option><option value="documents">Dokumen PDF</option></select></div><div class="field"><label for="media-files">File (bisa beberapa)</label><input id="media-files" type="file" multiple required/></div></div><button type="submit" class="btn" id="media-upload-button">Upload ke media library</button><p id="media-upload-status" class="status" role="status" aria-live="polite" aria-atomic="true"></p></form></div>
        <div class="panel"><div class="panel-head"><div><h2>File tersimpan</h2><p class="muted small" id="media-count">Memuat…</p></div><div class="toolbar"><input id="media-search" class="control" placeholder="Cari nama file…"/><select id="media-filter" class="control"><option value="">Semua kategori</option><option value="anggota">Anggota</option><option value="galeri">Galeri</option><option value="assets-global">Aset global</option><option value="assets">Aset umum</option><option value="icons">Ikon</option><option value="background">Background</option><option value="documents">Dokumen</option></select><button type="button" class="btn ghost small-btn" id="refresh-media">Muat ulang</button></div></div><div id="media-grid" class="media-grid"></div></div>
      </section>

      <section id="view-system" class="view">
        <div class="view-intro"><h2>Sistem, backup, dan riwayat</h2><p>Ekspor mencakup data dan metadata database CMS. File biner tetap tersimpan di Supabase Storage dan tidak disalin ke JSON backup.</p></div>
        <div class="panel"><h2>Backup database CMS</h2><p class="muted small">Ekspor untuk menyimpan salinan konfigurasi dan data. Import menggunakan upsert dan tidak menghapus baris lama.</p><div class="form-actions"><button type="button" id="export-backup" class="btn">Unduh backup JSON</button><label class="btn ghost" for="import-backup-file">Pilih file backup<input id="import-backup-file" type="file" accept="application/json,.json" hidden /></label></div><p id="backup-status" class="status" role="status" aria-live="polite" aria-atomic="true"></p></div>
        <div class="panel"><div class="panel-head"><div><h2>Riwayat versi</h2><p class="muted small">Versi pengaturan global dan metadata halaman yang pernah disimpan.</p></div><select id="revision-page" class="control" style="max-width:200px"><option value="site-settings">Pengaturan global</option><option value="/">Beranda</option><option value="/anggota">Anggota</option><option value="/galeri">Galeri</option><option value="/struktur">Struktur</option><option value="/keahlian">Keahlian</option><option value="/tkj">TKJ</option><option value="/pengembang">Pengembang</option></select></div><div id="revision-list" class="item-list"><div class="empty">Pilih sumber riwayat.</div></div><p id="revision-status" class="status" role="status" aria-live="polite" aria-atomic="true"></p></div>
        <div class="panel"><div class="panel-head"><div><h2>Audit log lengkap</h2><p class="muted small">Telusuri aktivitas admin dengan filter dan pagination.</p></div><button class="btn ghost small-btn" id="refresh-audit" type="button">Muat ulang</button></div>
          <div class="toolbar"><input id="audit-search" class="control" placeholder="Cari ringkasan aktivitas…"/><select id="audit-entity" class="control"><option value="">Semua entitas</option><option value="site_pages">Halaman</option><option value="site_page_drafts">Draft</option><option value="media_assets">Media</option><option value="anggota">Anggota</option><option value="galeri">Galeri</option><option value="site_settings">Pengaturan</option><option value="content_revisions">Revisi</option></select><select id="audit-action" class="control"><option value="">Semua aksi</option><option value="create">Create</option><option value="update">Update</option><option value="delete">Delete</option><option value="upload">Upload</option><option value="replace">Replace</option><option value="save-draft">Save draft</option><option value="publish">Publish</option><option value="discard-draft">Discard draft</option><option value="import">Import backup</option><option value="restore">Restore</option></select></div>
          <div id="audit-list" class="item-list" style="margin-top:14px"><div class="empty">Memuat audit log…</div></div>
          <div class="form-actions"><button class="btn ghost small-btn" id="audit-prev" type="button">Sebelumnya</button><span id="audit-page-label" class="muted small">Halaman 1</span><button class="btn ghost small-btn" id="audit-next" type="button">Berikutnya</button></div><p id="audit-status" class="status" role="status" aria-live="polite" aria-atomic="true"></p>
        </div>
      </section>

      <footer class="muted small" style="padding:26px 4px 0">TKJ XII-9 CMS · Data dikelola melalui server Astro dan Supabase Storage.</footer>
    </main>
  </div>

  <script>
    import '../../scripts/admin.js';
  </script>
</body>
</html>
