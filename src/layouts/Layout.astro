---
import Icon from '../components/Icon.astro';
import '../styles/dasar.css';
import '../styles/animasi.css';
import '../styles/tata-letak.css';
import '../styles/tombol.css';
import '../styles/kartu.css';
import '../styles/avatar.css';
import '../styles/formulir.css';
import '../styles/modal.css';
import GlobalClock from '../components/GlobalClock.astro';
import OfflineBadge from '../components/OfflineBadge.astro';
import LogoLightbox from '../components/LogoLightbox.astro';
import { getSettings, getPageSEO } from '../lib/data';
import { getSiteOrigin } from '../lib/site-url';
import { isAdminRequest } from '../lib/admin-auth';
import '../styles/draft-preview.css';
import '../styles/ui.css';
const previewRequested = Astro.url.searchParams.get('previewDraft') === '1' && isAdminRequest(Astro.request);
const [G, pageSEO] = await Promise.all([getSettings(), getPageSEO(Astro.url.pathname, Astro.request)]);
const draftPreview = previewRequested && pageSEO.draft_preview === true;
if (previewRequested) {
  // Preview tetap no-store meski query SEO gagal; konten draft tidak boleh tersimpan di CDN/browser cache.
  Astro.response.headers.set('Cache-Control', 'private, no-store, max-age=0, must-revalidate');
  Astro.response.headers.set('CDN-Cache-Control', 'no-store');
  Astro.response.headers.set('Cloudflare-CDN-Cache-Control', 'no-store');
  Astro.response.headers.set('Surrogate-Control', 'no-store');
  Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
  Astro.response.headers.set('Vary', 'Cookie');
}
const appearance = G.appearance || {};
const validHex = (value, fallback) => typeof value === 'string' && /^#[0-9a-fA-F]{6}$/.test(value) ? value : fallback;
const defaultTheme = ['dark', 'light', 'blue'].includes(appearance.theme) ? appearance.theme : 'dark';
const themeDefaults = {
  dark: { accent_color: '#dc2626', background_color: '#0a0505' },
  light: { accent_color: '#0d9488', background_color: '#f8fafc' },
  blue: { accent_color: '#2563eb', background_color: '#020617' },
};
const makeThemeVars = (theme) => {
  const saved = appearance.palettes?.[theme] || {};
  const legacy = theme === defaultTheme ? appearance : {};
  const defaults = themeDefaults[theme];
  const accent = validHex(saved.accent_color, validHex(legacy.accent_color, defaults.accent_color));
  const background = validHex(saved.background_color, validHex(legacy.background_color, defaults.background_color));
  const channels = [1, 3, 5].map((i) => parseInt(accent.slice(i, i + 2), 16));
  const shade = (amount) => `#${channels.map((channel) => Math.round(channel * (1 - amount)).toString(16).padStart(2, '0')).join('')}`;
  const tint = (amount) => `#${channels.map((channel) => Math.round(channel + (255 - channel) * amount).toString(16).padStart(2, '0')).join('')}`;
  return `html[data-theme="${theme}"]{--accent:${accent};--accent-2:${tint(0.16)};--accent-500:${accent};--accent-400:${tint(0.30)};--accent-700:${shade(0.28)};--accent-900:${shade(0.58)};--accent-100:${tint(0.88)};--accent-rgb:${channels.join(', ')};--primary:${accent};--bg:${background}}`;
};
const themePaletteCss = ['dark', 'light', 'blue'].map(makeThemeVars).join('\n');
const background = validHex(appearance.palettes?.[defaultTheme]?.background_color, validHex(appearance.background_color, themeDefaults[defaultTheme].background_color));
const siteName = `${G.namaKelas || 'XII-9'} ${G.jurusan || 'Teknik Komputer dan Jaringan'} — ${G.namaSekolah || 'SMK Muhammadiyah Belitang'}`;
const configuredBaseUrl = getSiteOrigin(Astro.url.origin);
const faviconUrl = G.media?.favicon_url || null;
const customBackground = typeof appearance.background_image_url === 'string' && /^https:\/\//.test(appearance.background_image_url) && !/["'()]/.test(appearance.background_image_url) ? appearance.background_image_url : null;

const { title, description } = Astro.props;

// SEO
const canonicalURL = new URL(Astro.url.pathname, configuredBaseUrl);
const finalTitle = pageSEO.title || title || `${G.namaKelas} ${G.jurusan} — ${G.namaSekolah}`;
const finalDescription = pageSEO.description || description || G.sloganHero;
const ogTitle = finalTitle;
const ogDesc = finalDescription;
const ogImage = pageSEO.og_image || G.ogImage || G.media?.og_url || G.media?.logo_url || '';
const robotsContent = previewRequested || pageSEO.noindex ? 'noindex, nofollow' : 'index, follow';
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@type': 'EducationalOrganization', name: siteName, description: finalDescription, url: configuredBaseUrl })
  .replace(/</g, '\\u003c')
  .replace(/[\u2028\u2029]/g, (character) => character === '\u2028' ? '\\u2028' : '\\u2029');
---

<!doctype html>
<html lang="id" data-theme={defaultTheme}>
  <head>
    <meta charset="UTF-8" />
    <!-- Anti-FOUC: restore saved theme instantly before paint -->
    <script is:inline>
      (function() {
        let t = null; try { t = localStorage.getItem('tkj-theme'); } catch (e) {}
        const valid = ['light', 'dark', 'blue'];
        if (t && valid.includes(t)) {
          document.documentElement.setAttribute('data-theme', t);
        }
      })();
    </script>
    <style is:inline set:html={themePaletteCss}></style>

    <noscript><style>.reveal,.reveal-left,.reveal-scale{opacity:1!important;visibility:visible!important;transform:none!important;pointer-events:auto!important}.item-galeri img{opacity:1!important}</style></noscript>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />


    <!-- SEO -->
    <title>{finalTitle}</title>
    <meta
      name="description"
      content={finalDescription}
    />
    <meta name="robots" content={robotsContent} />
    <link rel="canonical" href={canonicalURL} />

    <!-- OpenGraph / Social -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDesc} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:site_name" content={siteName} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDesc} />
    <meta name="twitter:image" content={ogImage} />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={jsonLd}></script>

    <!-- PWA -->
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content={background} />

    <!-- Favicon (inline SVG) -->
    {faviconUrl ? (
      <link rel="icon" href={faviconUrl} />
    ) : (
      <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='6' fill='%23b91c1c'/><text x='50%' y='55%' dominant-baseline='middle' text-anchor='middle' font-family='monospace' font-weight='700' font-size='13' fill='white'>TKJ</text></svg>" />
    )}

    <!-- Fonts Preload -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;700&family=Rajdhani:wght@500;700&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;700&family=Rajdhani:wght@500;700&display=swap"
      media="print"
      onload="this.media = 'all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;700&family=Rajdhani:wght@500;700&display=swap"
      />
    </noscript>

  </head>
  <body style={customBackground ? `background-image:linear-gradient(180deg,rgba(10,5,5,.9),rgba(10,5,5,.96)),url("${customBackground}");background-size:cover;background-attachment:fixed;background-position:center` : undefined}>
    {draftPreview && <div class="draft-preview-banner" role="status">PRATINJAU DRAFT · Tidak dipublikasikan · <a href={Astro.url.pathname}>Keluar dari pratinjau</a></div>}
    <canvas id="kanvas-jaringan"></canvas>
    <iframe id="bingkai-audio" src="/audio-player.html" style="display: none" aria-hidden="true" allow="autoplay"></iframe>
    
    <a class="skip-link" href="#main-content">Lewati ke konten utama</a>
    <div id="progres-halaman" aria-hidden="true"></div>
    <div id="progres-gulir" aria-hidden="true"></div>

    <slot />

    <button id="back-to-top" aria-label="Kembali ke atas">
      <Icon name="fa-chevron-up" />
    </button>

    <GlobalClock />
    <OfflineBadge />
    <LogoLightbox />

    <!-- Client-side Scripts -->
    <script>
      // Load global initialization script
      import '../scripts/utama.js';
    </script>

    <!-- Service Worker Registration -->
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function() {
          navigator.serviceWorker.register('/sw.js').catch(function(err) {
            console.warn('[SW] Registration failed:', err);
          });
        });
      }
    </script>
  </body>
</html>
